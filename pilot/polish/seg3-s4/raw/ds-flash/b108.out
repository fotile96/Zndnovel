{"id": 13979, "jp_tail": "アヤノ】「嫌！」", "zh": "【アヤノ】「不要！」", "score": 90, "note": "", "adjudicate": false}
{"id": 13980, "jp_tail": "ノの腕を掴んだ。", "zh": "我抓住了アヤノ的手臂。", "score": 88, "note": "", "adjudicate": false}
{"id": 13981, "jp_tail": "身体を捻ると――", "zh": "アヤノ扭动着身子――_n身体一拧――", "score": 85, "note": "", "adjudicate": false}
{"id": 13982, "jp_tail": "チ】「……ッ！」", "zh": "【ユウイチ】「……唔！」", "score": 88, "note": "", "adjudicate": false}
{"id": 13983, "jp_tail": "ノの腕を掴んだ。", "zh": "我慌忙抓住了アヤノ的手臂。", "score": 85, "note": "", "adjudicate": false}
{"id": 13984, "jp_tail": "ことすんだよ！」", "zh": "【ユウイチ】「你为什么要做那种事啊！」", "score": 88, "note": "jp 与 13951 全等，逐字同形", "adjudicate": false}
{"id": 13985, "jp_tail": "ノ】「…………」", "zh": "【アヤノ】「…………」", "score": 92, "note": "", "adjudicate": false}
{"id": 13986, "jp_tail": "ノの返事はない。", "zh": "アヤノ没有回应。", "score": 85, "note": "", "adjudicate": false}
{"id": 13987, "jp_tail": "腕を下げている。", "zh": "就那样闭着眼睛，一只手无力地垂着。", "score": 85, "note": "", "adjudicate": false}
{"id": 13988, "jp_tail": "見ているように。", "zh": "……简直像是在做梦一样。", "score": 85, "note": "", "adjudicate": false}
{"id": 13989, "jp_tail": "ユウイチ】「！」", "zh": "【ユウイチ】「！」", "score": 92, "note": "", "adjudicate": false}
{"id": 13990, "jp_tail": "汗で滑っていく。", "zh": "手被汗浸着，一点一点地滑了下去。", "score": 85, "note": "", "adjudicate": false}
{"id": 13991, "jp_tail": "どうすんだよ！」", "zh": "【ユウイチ】「别开玩笑了！ 你要是做了那种事，我该怎么办啊！」", "score": 85, "note": "", "adjudicate": false}
{"id": 13992, "jp_tail": "俺は目を細めた。", "zh": "从下面吹上来的风把灰尘卷进眼睛，我不由得眯起了眼。", "score": 85, "note": "", "adjudicate": false}
{"id": 13993, "jp_tail": "ゆらりと揺れる。", "zh": "那一瞬间，アヤノ的身体晃悠悠地摇了一下。", "score": 85, "note": "", "adjudicate": false}
{"id": 13994, "jp_tail": "（……くっ！）」", "zh": "【ユウイチ】「（……唔！）」", "score": 88, "note": "", "adjudicate": false}
{"id": 13995, "jp_tail": "腕を持ち直した。", "zh": "我慌忙重新握紧了アヤノ的手臂。", "score": 85, "note": "", "adjudicate": false}
{"id": 13996, "jp_tail": "ノ】「…………」", "zh": "【アヤノ】「…………」", "score": 92, "note": "", "adjudicate": false}
{"id": 13997, "jp_tail": "腕を握りしめる。", "zh": "我一边发出低吼般的声音，一边紧紧攥住アヤノ的手臂。", "score": 85, "note": "", "adjudicate": false}
{"id": 13998, "jp_tail": "な痛みが走った。", "zh": "右手窜过一阵刺痛。", "score": 85, "note": "", "adjudicate": false}
{"id": 13999, "jp_tail": "これは――", "zh": "这是――", "score": 90, "note": "", "adjudicate": false}
{"id": 14000, "jp_tail": "傷が、開いて――", "zh": "看アヤノ笔记本时弄出的伤口，裂开了――", "score": 85, "note": "", "adjudicate": false}
{"id": 14001, "jp_tail": "……く……。", "zh": "……唔……。", "score": 90, "note": "", "adjudicate": false}
{"id": 14002, "jp_tail": "ままじゃあ……。", "zh": "不行，照这样下去……。", "score": 85, "note": "", "adjudicate": false}
{"id": 14003, "jp_tail": "ら、あの時の――", "zh": "不，要是在这里放弃，就会重蹈那时的――", "score": 82, "note": "", "adjudicate": false}
{"id": 14004, "jp_tail": "舞にだけは――！", "zh": "――覆辙，绝对不行――！", "score": 82, "note": "", "adjudicate": false}
{"id": 14005, "jp_tail": "ショウぉぉー！」", "zh": "【ユウイチ】「可、恶——！」", "score": 88, "note": "", "adjudicate": false}
{"id": 14006, "jp_tail": "その時だった。", "zh": "就在那时。", "score": 92, "note": "", "adjudicate": false}
{"id": 14007, "jp_tail": "びくんと震えた。", "zh": "アヤノ的身体猛地大大颤了一下。", "score": 85, "note": "", "adjudicate": false}
{"id": 14008, "jp_tail": "……ユウイチ？」", "zh": "【アヤノ】「……ユウイチ？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14009, "jp_tail": "いくのがわかる。", "zh": "能感觉到手臂上渐渐使上了力气。", "score": 85, "note": "", "adjudicate": false}
{"id": 14010, "jp_tail": "アヤ……ノっ！」", "zh": "【ユウイチ】「アヤ……ノ！」", "score": 88, "note": "", "adjudicate": false}
{"id": 14011, "jp_tail": "れ、ユウイチ？」", "zh": "【アヤノ】「……咦，ユウイチ？」", "score": 85, "note": "", "adjudicate": false}
{"id": 14012, "jp_tail": "っくり下を向く。", "zh": "アヤノ的视线慢慢转向下方。", "score": 85, "note": "", "adjudicate": false}
{"id": 14013, "jp_tail": "、こ……嫌……」", "zh": "【アヤノ】「呀……什么，这……不要……」", "score": 85, "note": "", "adjudicate": false}
{"id": 14014, "jp_tail": "けに力いれて！」", "zh": "【ユウイチ】「笨蛋别往下看！ 听好了，闭上眼睛，把力气全使在手臂上！」", "score": 82, "note": "", "adjudicate": false}
{"id": 14015, "jp_tail": "チ？ なんで？」", "zh": "【アヤノ】「可是这里，是哪儿？ ユウイチ？ 为什么？」", "score": 85, "note": "", "adjudicate": false}
{"id": 14016, "jp_tail": "…いいからっ！」", "zh": "【ユウイチ】「……别管那么多了！」", "score": 85, "note": "", "adjudicate": false}
{"id": 14017, "jp_tail": "「ユウイチ……」", "zh": "【アヤノ】「ユウイチ……」", "score": 90, "note": "", "adjudicate": false}
{"id": 14018, "jp_tail": "のバカアヤノ！」", "zh": "【ユウイチ】「给我打起精神来啊你这个笨蛋アヤノ！」", "score": 82, "note": "", "adjudicate": false}
{"id": 14020, "jp_tail": "掴まってろよ？」", "zh": "【ユウイチ】「绝对！ 绝对不许松手，听好了，我这就把你拉上去，给我抓牢了？」", "score": 82, "note": "", "adjudicate": false}
{"id": 14021, "jp_tail": "「う、うん――」", "zh": "【アヤノ】「嗯、嗯――」", "score": 88, "note": "", "adjudicate": false}
{"id": 14022, "jp_tail": "腕を全力で掴む。", "zh": "我用尽全力抓住アヤノ的手臂。", "score": 85, "note": "", "adjudicate": false}
{"id": 14023, "jp_tail": "ラ入れるんだ！」", "zh": "【ユウイチ】「我数『一二三』。数到『三』的时候，全身的力气给我使出来！」", "score": 85, "note": "", "adjudicate": false}
{"id": 14024, "jp_tail": "ノ】「――うん」", "zh": "【アヤノ】「――嗯」", "score": 90, "note": "", "adjudicate": false}
{"id": 14025, "jp_tail": "の――さんっ！」", "zh": "【ユウイチ】「预备——，一、二――三！」", "score": 85, "note": "", "adjudicate": false}
{"id": 14028, "jp_tail": "うやく止まった。", "zh": "我们就那样抱在一起在天台上滚了出去，最后总算被围栏挡住了。", "score": 85, "note": "", "adjudicate": false}
{"id": 14029, "jp_tail": "…助かったのだ。", "zh": "……得救了。", "score": 88, "note": "有意的 W4 分歧：此处为两人得救，删主语（纪要 §3）", "adjudicate": false}
{"id": 14030, "jp_tail": "「……よかった」", "zh": "【ユウイチ】「……太好了」", "score": 88, "note": "", "adjudicate": false}
{"id": 14031, "jp_tail": "「ユウイチ――」", "zh": "【アヤノ】「ユウイチ――」", "score": 90, "note": "", "adjudicate": false}
{"id": 14032, "jp_tail": "よ？ アヤノ？」", "zh": "【ユウイチ】「你到底怎么了？ アヤノ？」", "score": 85, "note": "", "adjudicate": false}
{"id": 14033, "jp_tail": "肩に手を置いた。", "zh": "我这么说着，把手放在了アヤノ的两肩上。", "score": 85, "note": "", "adjudicate": false}
{"id": 14034, "jp_tail": "……わかんない」", "zh": "【アヤノ】「不、不知道。真的……不知道」", "score": 85, "note": "", "adjudicate": false}
{"id": 14035, "jp_tail": "、私教室にいて」", "zh": "【アヤノ】「因为直到刚才，我都还在教室里」", "score": 85, "note": "", "adjudicate": false}
{"id": 14036, "jp_tail": "屋上に居て――」", "zh": "【アヤノ】「在２年Ｂ班，和一个叫サクラ的女孩子一起请了钱仙，然后回过神来就在天台上――」", "score": 85, "note": "", "adjudicate": false}
{"id": 14037, "jp_tail": "ウイチ】「……」", "zh": "【ユウイチ】「……」", "score": 95, "note": "", "adjudicate": false}
{"id": 14038, "jp_tail": "なかったはずだ。", "zh": "……教室？ 刚才我查看的时候，アヤノ应该根本不在教室里才对。", "score": 85, "note": "", "adjudicate": false}
{"id": 14039, "jp_tail": "、なんだろうか。", "zh": "……是错过了吗。", "score": 65, "note": "「是错过了，吗」中顿不自然（原文なんだろうか的犹疑靠前后文承载），删顿号", "adjudicate": false}
{"id": 14040, "jp_tail": "ノは混乱してる。", "zh": "不，不好说。说到底，现在的アヤノ正处在混乱里。", "score": 85, "note": "", "adjudicate": false}
{"id": 14041, "jp_tail": "るとは限らない。", "zh": "这么说虽然不太好，可アヤノ的话未必靠得住。", "score": 82, "note": "", "adjudicate": false}
{"id": 14042, "jp_tail": "屋上にいて――」", "zh": "【アヤノ】「在天台上――」", "score": 85, "note": "", "adjudicate": false}
{"id": 14043, "jp_tail": "居たんだろう？」", "zh": "【アヤノ】「不知道。我为什么会在天台上呢？」", "score": 85, "note": "", "adjudicate": false}
{"id": 14044, "jp_tail": "居たんだろう？」", "zh": "【アヤノ】「为什么我会差点从天台上掉下去呢？ 为什么回过神来ユウイチ就在那里呢？」", "score": 85, "note": "", "adjudicate": false}
{"id": 14045, "jp_tail": "ため息をついた。", "zh": "我叹了口气。", "score": 88, "note": "", "adjudicate": false}
{"id": 14046, "jp_tail": "…わかったから」", "zh": "【ユウイチ】「……知道了啦」", "score": 85, "note": "", "adjudicate": false}
{"id": 14047, "jp_tail": "体を抱きしめた。", "zh": "我抱住了アヤノ的身体。", "score": 85, "note": "", "adjudicate": false}
{"id": 14048, "jp_tail": "……まったく。", "zh": "……真是的。", "score": 90, "note": "", "adjudicate": false}
{"id": 14049, "jp_tail": "「ユウイチ――」", "zh": "【アヤノ】「ユウイチ――」", "score": 92, "note": "", "adjudicate": false}
{"id": 14050, "jp_tail": "』ならいいから」", "zh": "【ユウイチ】「只要你『变回原来的样子』就行了」", "score": 85, "note": "", "adjudicate": false}
{"id": 14051, "jp_tail": "たのがわかった。", "zh": "能感觉到アヤノ把手绕到了我的背上。", "score": 85, "note": "", "adjudicate": false}
{"id": 14052, "jp_tail": "がと、ユウイチ」", "zh": "【アヤノ】「谢啦，ユウイチ」", "score": 85, "note": "", "adjudicate": false}
{"id": 14053, "jp_tail": "たし。役得役得」", "zh": "【ユウイチ】「不，嘛，也没什么。你爬围栏的时候，内裤也看到了。捞着了捞着了」", "score": 85, "note": "", "adjudicate": false}
{"id": 14054, "jp_tail": "戻る扉を開けた。", "zh": "我，――一边揉着头――打开了从天台回校舍的门。", "score": 85, "note": "", "adjudicate": false}
{"id": 14055, "jp_tail": "ゆっくりと下る。", "zh": "两个人慢慢地走下楼梯。", "score": 85, "note": "", "adjudicate": false}
{"id": 14056, "jp_tail": "ったのかな……」", "zh": "【アヤノ】「到底是什么呢……」", "score": 85, "note": "", "adjudicate": false}
{"id": 14057, "jp_tail": "ウイチ】「ん？」", "zh": "【ユウイチ】「嗯？」", "score": 92, "note": "", "adjudicate": false}
{"id": 14058, "jp_tail": "アヤノが呟いた。", "zh": "アヤノ一边指着裤子右边的口袋――字条原先所在的地方，一边嘀咕道。", "score": 85, "note": "", "adjudicate": false}
{"id": 14059, "jp_tail": "だったのかな？」", "zh": "【アヤノ】「……结果。天台的秘密，到底是什么呢？」", "score": 85, "note": "", "adjudicate": false}
{"id": 14060, "jp_tail": "否定できないわ」", "zh": "【ユウイチ】「不知道……不过。有什么不可思议的事牵扯在里面，这一点看来是确定的。经历了那种事……我也没法否定了」", "score": 82, "note": "", "adjudicate": false}
{"id": 14061, "jp_tail": "ノ】「……うん」", "zh": "【アヤノ】「……嗯」", "score": 90, "note": "", "adjudicate": false}
{"id": 14062, "jp_tail": "教室に戻った。", "zh": "回到了教室。", "score": 88, "note": "", "adjudicate": false}
{"id": 14063, "jp_tail": "た事を説明した。", "zh": "我说明了アヤノ的课桌倒在地上的事，还有因为在意那副狼藉的样子而开始找アヤノ的事。", "score": 85, "note": "", "adjudicate": false}
{"id": 14064, "jp_tail": "アヤノの机……。", "zh": "アヤノ的课桌……。", "score": 88, "note": "", "adjudicate": false}
{"id": 14065, "jp_tail": "、見たんだよな。", "zh": "……我可是擅自看了笔记本里面的东西啊。", "score": 85, "note": "", "adjudicate": false}
{"id": 14066, "jp_tail": "トが目に入って」", "zh": "【ユウイチ】「对不起。想把课桌扶回原样的时候，看到了笔记本」", "score": 85, "note": "", "adjudicate": false}
{"id": 14067, "jp_tail": "か。中、見た？」", "zh": "【アヤノ】「这样啊。里面，看了？」", "score": 85, "note": "", "adjudicate": false}
{"id": 14068, "jp_tail": "】「……ごめん」", "zh": "【ユウイチ】「……对不起」", "score": 90, "note": "", "adjudicate": false}
{"id": 14069, "jp_tail": "俺は頷いた。", "zh": "我点了点头。", "score": 88, "note": "", "adjudicate": false}
{"id": 14070, "jp_tail": "てくれたんだし」", "zh": "【アヤノ】「没关系哦。如果是ユウイチ的话。……而且你还救了我」", "score": 85, "note": "", "adjudicate": false}
{"id": 14071, "jp_tail": "ではないよな？」", "zh": "【ユウイチ】「不过，那本笔记本上写的到底是什么啊？ 怎么说呢，那个……内容不太正常吧？」", "score": 82, "note": "", "adjudicate": false}
{"id": 14072, "jp_tail": "えてもらった事」", "zh": "【アヤノ】「这个呢，是サクラ同学教给我的」", "score": 85, "note": "", "adjudicate": false}
{"id": 14073, "jp_tail": "チ】「さくら？」", "zh": "【ユウイチ】「さくら？」", "score": 88, "note": "原文平假名保留（字形装置，纪要 §6）", "adjudicate": false}
{"id": 14074, "jp_tail": "ん、サクラさん」", "zh": "【アヤノ】「嗯，サクラ同学」", "score": 88, "note": "", "adjudicate": false}
{"id": 14075, "jp_tail": "ノが言うには――", "zh": "据アヤノ说――", "score": 88, "note": "", "adjudicate": false}
{"id": 14076, "jp_tail": "したのだという。", "zh": "她和サクラ是在中庭偶然相遇，聊着聊着就意气相投了。", "score": 85, "note": "", "adjudicate": false}
{"id": 14077, "jp_tail": "めることだった。", "zh": "サクラ的兴趣，是搜集学校里流传的那些有点『不可思议的故事』和『咒语』。", "score": 82, "note": "", "adjudicate": false}
{"id": 14078, "jp_tail": "うようになった。", "zh": "アヤノ对学校七大不可思议之类的故事也不算讨厌，于是就开始从她那里听来各种各样的故事。", "score": 82, "note": "", "adjudicate": false}
{"id": 14079, "jp_tail": "なるなんて……」", "zh": "【アヤノ】「可是，居然会变成这样……」", "score": 85, "note": "", "adjudicate": false}
{"id": 14080, "jp_tail": "落としていった。", "zh": "アヤノ垂着肩膀说道。", "score": 85, "note": "", "adjudicate": false}
{"id": 14081, "jp_tail": "ていた、という。", "zh": "据说刚才两个人也正在请钱仙――回过神来就在天台上，还握着我的手。", "score": 82, "note": "", "adjudicate": false}
{"id": 14082, "jp_tail": "の可能性が高い。", "zh": "从长相来看，我在天台上遇见的少女――是サクラ的可能性很高。", "score": 65, "note": "「从相貌上想」直译腔（風貌から考えるに），改「从长相来看」", "adjudicate": false}
{"id": 14083, "jp_tail": "少女であった事。", "zh": "我在天台上遇见的『少女』就是サクラ这件事，还有留下字条的人就是那个少女这件事。", "score": 85, "note": "", "adjudicate": false}
{"id": 14084, "jp_tail": "えてしまった事。", "zh": "还有那孩子从天台上突然消失了这件事。", "score": 85, "note": "", "adjudicate": false}
{"id": 14085, "jp_tail": "黙ってしまった。", "zh": "把天台上发生的事说明给アヤノ听之后，アヤノ只说了一句『ユウイチ也……』，就沉默了下来。", "score": 85, "note": "", "adjudicate": false}
{"id": 14086, "jp_tail": "つまり――", "zh": "也就是――", "score": 90, "note": "", "adjudicate": false}
{"id": 14087, "jp_tail": "という事になる。", "zh": "两个人都围绕着サクラ，经历了『不可思议的体验』。", "score": 85, "note": "", "adjudicate": false}
{"id": 14090, "jp_tail": "アヤノ】「……」", "zh": "【アヤノ】「……」", "score": 95, "note": "", "adjudicate": false}
{"id": 14091, "jp_tail": "外を眺めている。", "zh": "アヤノ默默地望着窗外。", "score": 85, "note": "", "adjudicate": false}
{"id": 14092, "jp_tail": "うしようか……。", "zh": "接下来，该怎么办呢……。", "score": 85, "note": "", "adjudicate": false}
