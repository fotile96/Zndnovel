{"id": 5675, "jp_tail": "遠くなっていく。", "zh": "意识渐渐远去。", "score": 95, "note": "", "adjudicate": false}
{"id": 5676, "jp_tail": "が聞こえてくる。", "zh": "远处传来了音乐。", "score": 95, "note": "", "adjudicate": false}
{"id": 5677, "jp_tail": "…私は思い出す。", "zh": "……我想起来了。", "score": 95, "note": "", "adjudicate": false}
{"id": 5678, "jp_tail": "帰りの歌、だ。", "zh": "回家的歌谣，就是它。", "score": 95, "note": "", "adjudicate": false}
{"id": 5679, "jp_tail": "『戻らないと』。", "zh": "『得回去才行』。", "score": 95, "note": "", "adjudicate": false}
{"id": 5680, "jp_tail": "の中で私は思う。", "zh": "在一点点失去的意识里，我想着。", "score": 95, "note": "", "adjudicate": false}
{"id": 5681, "jp_tail": "を澄まさないと。", "zh": "得侧耳细听才行。", "score": 95, "note": "", "adjudicate": false}
{"id": 5682, "jp_tail": "葉を聞かないと。", "zh": "得听清话语才行。", "score": 95, "note": "", "adjudicate": false}
{"id": 5685, "jp_tail": "曲を聴かないと。", "zh": "得听那支曲子才行。", "score": 95, "note": "", "adjudicate": false}
{"id": 5686, "jp_tail": "言葉を書かないと", "zh": "得把话语写下才行", "score": 95, "note": "", "adjudicate": false}
{"id": 5687, "jp_tail": "言葉を", "zh": "把话语", "score": 95, "note": "", "adjudicate": false}
