{"id": 11956, "jp_tail": "してここに……！", "zh": "ユウイチ……为什么会在这里……！", "score": 90, "note": "", "adjudicate": false}
{"id": 11957, "jp_tail": "よ！ アヤノ！」", "zh": "【ユウイチ】「喂，等一下啊！ アヤノ！」", "score": 92, "note": "", "adjudicate": false}
{"id": 11958, "jp_tail": "を駆け上がった。", "zh": "我甩开ユウイチ的手，冲上了楼梯。", "score": 90, "note": "腕→手（与 9991/9997 同构，批84手记§2）", "adjudicate": false}
{"id": 11959, "jp_tail": "】「アヤノ……」", "zh": "【ユウイチ】「アヤノ……」", "score": 92, "note": "", "adjudicate": false}
{"id": 11960, "jp_tail": "見たくないの！」", "zh": "【アヤノ】「不要过来！ ユウイチ的脸，我再也不想看到第二眼了！」", "score": 90, "note": "", "adjudicate": false}
{"id": 11961, "jp_tail": "と、扉を閉めた。", "zh": "我打开天台的门，侧身滑了进去，随即关上了门。", "score": 88, "note": "", "adjudicate": false}
{"id": 11962, "jp_tail": "ウイチ】「……」", "zh": "【ユウイチ】「……」", "score": 92, "note": "", "adjudicate": false}
{"id": 11963, "jp_tail": "くのがわかった。", "zh": "我听得出来，脚步声正一点一点地远去。", "score": 88, "note": "", "adjudicate": false}
{"id": 11964, "jp_tail": "けの匂いがした。", "zh": "一踏上天台，就感觉到带着湿气的风扑在脸上。闻得到晚霞的味道。", "score": 90, "note": "夕焼け→晚霞（v3 定译族，批84手记§1）", "adjudicate": false}
{"id": 11965, "jp_tail": "ゆらりと動いた。", "zh": "环视四周，看见混凝土地面上落着格子状的影子，对比强烈。忽然，那影子，晃悠悠地动了一下。", "score": 88, "note": "", "adjudicate": false}
{"id": 11966, "jp_tail": "して目を上げた。", "zh": "我心里一惊，抬起了眼。", "score": 90, "note": "", "adjudicate": false}
{"id": 11967, "jp_tail": "『彼女』がいた。", "zh": "『她』在那里。", "score": 92, "note": "『彼女』不点名，与 1994/1997/2030 同一体例", "adjudicate": false}
{"id": 11968, "jp_tail": "サクラさん……」", "zh": "【アヤノ】「サクラ同学……」", "score": 92, "note": "", "adjudicate": false}
{"id": 11969, "jp_tail": "それでいいの？」", "zh": "【サクラ】「アヤノ同学，那样就好吗？」", "score": 90, "note": "", "adjudicate": false}
{"id": 11970, "jp_tail": "坦な声で言った。", "zh": "サクラ同学一看见我的脸，就用一种像在朗读课本似的平板声音说道。", "score": 88, "note": "", "adjudicate": false}
{"id": 11971, "jp_tail": "じられなかった。", "zh": "那声音里，感觉不到一丝叫做感情的东西。", "score": 88, "note": "", "adjudicate": false}
{"id": 11972, "jp_tail": "れでいいって？」", "zh": "【アヤノ】「那个，サクラ同学？ 那样就好，是什么意思？」", "score": 90, "note": "", "adjudicate": false}
{"id": 11973, "jp_tail": "ままでいいの？」", "zh": "【サクラ】「就这样下去就可以吗？」", "score": 93, "note": "复现句族 11973＝12053＝12294，逐字同译（批84手记§3）", "adjudicate": false}
{"id": 11974, "jp_tail": "て言葉を続けた。", "zh": "サクラ同学无视我的问题，继续说了下去。", "score": 90, "note": "", "adjudicate": false}
{"id": 11975, "jp_tail": "？ どうし――」", "zh": "【アヤノ】「那个，サクラ同学？ 你到底怎――」", "score": 90, "note": "", "adjudicate": false}
{"id": 11976, "jp_tail": "うしているの？」", "zh": "【サクラ】「アヤノ同学要一直那样下去吗？」", "score": 90, "note": "", "adjudicate": false}
{"id": 11977, "jp_tail": "サクラさん……」", "zh": "【アヤノ】「サクラ同学……」", "score": 92, "note": "", "adjudicate": false}
{"id": 11978, "jp_tail": "ん、と頭が痛む。", "zh": "一阵，一阵，头抽痛着。", "score": 92, "note": "与已入线 8450 前半逐字同文，沿用", "adjudicate": false}
{"id": 11979, "jp_tail": "ばっかりだよね」", "zh": "【サクラ】「可是，アヤノ同学总是在逃避呢」", "score": 90, "note": "", "adjudicate": false}
{"id": 11980, "jp_tail": "「そんな事――」", "zh": "【アヤノ】「哪有那种事――」", "score": 90, "note": "", "adjudicate": false}
{"id": 11981, "jp_tail": "。さっきだって」", "zh": "【サクラ】「从ユウイチ同学身边也是。刚才也是」", "score": 90, "note": "", "adjudicate": false}
{"id": 11982, "jp_tail": "アヤノ】「え？」", "zh": "【アヤノ】「诶？」", "score": 92, "note": "", "adjudicate": false}
{"id": 11983, "jp_tail": "良かったのにね」", "zh": "【サクラ】「为什么马上就从图书室跑出来了呢？ 明明追问清楚就好了呀」", "score": 90, "note": "", "adjudicate": false}
{"id": 11984, "jp_tail": "クラさんは笑う。", "zh": "サクラ同学抿着嘴，坏心眼地笑着。", "score": 88, "note": "クスクス→抿着嘴笑（804/11352 既有线）", "adjudicate": false}
{"id": 11985, "jp_tail": "事を知っている？", "zh": "为什么，サクラ同学会知道这件事？", "score": 90, "note": "", "adjudicate": false}
{"id": 11986, "jp_tail": "逃げてばかり』」", "zh": "【サクラ】「『アヤノ，总是只会逃避』」", "score": 92, "note": "原文此处独独去掉「さん」用裸称+『』，照搬", "adjudicate": false}
{"id": 11987, "jp_tail": "サクラ……さん」", "zh": "【アヤノ】「サクラ……同学」", "score": 92, "note": "", "adjudicate": false}
{"id": 11988, "jp_tail": "も逃げちゃった」", "zh": "【サクラ】「已经太迟了呢。你连ユウイチ同学也逃开了」", "score": 90, "note": "", "adjudicate": false}
{"id": 11989, "jp_tail": "いよ。どこにも」", "zh": "【サクラ】「已经，逃不掉了哦。哪里都逃不掉」", "score": 93, "note": "复现句族 11989＝12008，逐字同译", "adjudicate": false}
{"id": 11990, "jp_tail": "れないって事が」", "zh": "【サクラ】「你明白的吧。『那样一来』就再也，无论向前还是向后，哪里都去不了，再也回不到原来的关系了」", "score": 88, "note": "", "adjudicate": false}
{"id": 11991, "jp_tail": "の、そんな――」", "zh": "【アヤノ】「别、别说了，为什么要说那种话，那种――」", "score": 90, "note": "", "adjudicate": false}
{"id": 11992, "jp_tail": "や、叫んでいた。", "zh": "一阵恶心涌了上来。我抱着头说道。_n不，是喊了出来。", "score": 90, "note": "", "adjudicate": false}
{"id": 11993, "jp_tail": "んじゃない――」", "zh": "【アヤノ】「会说这种话的，才不是サクラ同学――」", "score": 90, "note": "", "adjudicate": false}
{"id": 11994, "jp_tail": "れるような感覚。", "zh": "胸口痛了起来。有一种后脑勺被拽向某个遥远地方的感觉。", "score": 88, "note": "", "adjudicate": false}
{"id": 11995, "jp_tail": "ときと、同じだ。", "zh": "……一样。和那时候。和看见ユウイチ和ユカリ老师在图书室里抱在一起的那时候，一样。", "score": 90, "note": "", "adjudicate": false}
{"id": 11996, "jp_tail": "気分になれない」", "zh": "【アヤノ】「对不起……サクラ同学……。现在……我没有心情……和你说话」", "score": 90, "note": "保留原文三处省略号的断法（批84手记§3）", "adjudicate": false}
{"id": 11997, "jp_tail": "たくはなかった。", "zh": "我已经谁也不想见了。", "score": 90, "note": "", "adjudicate": false}
{"id": 11998, "jp_tail": "に向かっていた。", "zh": "脚自然而然地朝天台的出口走去。", "score": 90, "note": "", "adjudicate": false}
{"id": 11999, "jp_tail": "して響いている。", "zh": "我用尽全力推开门，像纵身跃进去似的钻了进去。沿着楼梯往下走。脚步声拖着长长的余响，回荡着。", "score": 85, "note": "「靴の足音」是日语惯用说法，中文「鞋子的脚步声」冗余，删「鞋子的」", "adjudicate": false}
{"id": 12000, "jp_tail": "に行きたかった。", "zh": "总之，现在，只想去一个没有人的地方。", "score": 90, "note": "", "adjudicate": false}
{"id": 12001, "jp_tail": "段、踊り場……。", "zh": "楼梯、转角平台、楼梯、转角平台……。", "score": 92, "note": "踊り場→转角平台（9949 列举位形）", "adjudicate": false}
{"id": 12002, "jp_tail": "るのが分かった。", "zh": "呼吸开始变得急促。喉咙深处发烫，我能觉出呼吸里混进了血的味道。", "score": 88, "note": "", "adjudicate": false}
{"id": 12003, "jp_tail": "……。", "zh": "……。", "score": 92, "note": "", "adjudicate": false}
{"id": 12004, "jp_tail": "、おかしかった。", "zh": "有什么地方，不对劲。", "score": 90, "note": "", "adjudicate": false}
{"id": 12005, "jp_tail": "度も、何十段も。", "zh": "从刚才起，我已经下了好多次楼梯。好多次，好几十级台阶。", "score": 90, "note": "", "adjudicate": false}
{"id": 12006, "jp_tail": "えてこなかった。", "zh": "可是，那道楼梯的『尽头』，怎么也看不到。", "score": 90, "note": "", "adjudicate": false}
{"id": 12007, "jp_tail": "てこないのだ？』", "zh": "『为什么这道楼梯，看不到尽头？』", "score": 92, "note": "保留原文书面腔冷句与『』（批84手记§3）", "adjudicate": false}
{"id": 12008, "jp_tail": "いよ。どこにも」", "zh": "【サクラ】「已经，逃不掉了哦。哪里都逃不掉」", "score": 93, "note": "与 11989 逐字同译", "adjudicate": false}
{"id": 12009, "jp_tail": "頭の中に蘇った。", "zh": "サクラ同学的话，就像有人按下了录像带的播放键一样，在脑海里重新响了起来。", "score": 88, "note": "", "adjudicate": false}
{"id": 12010, "jp_tail": "背筋が寒くなる。", "zh": "背脊一阵发凉。", "score": 92, "note": "", "adjudicate": false}
{"id": 12011, "jp_tail": "るの？ まさか」", "zh": "【アヤノ】「这是怎么回事？ 难道说」", "score": 90, "note": "", "adjudicate": false}
{"id": 12012, "jp_tail": "段、踊り場……。", "zh": "我朝楼梯下面探头望去。看见的是像方形漩涡一样螺旋着盘下去的楼梯。楼梯、转角平台、楼梯、转角平台……。", "score": 88, "note": "", "adjudicate": false}
{"id": 12013, "jp_tail": "なに、これ……」", "zh": "【アヤノ】「什么啊，这是……」", "score": 90, "note": "", "adjudicate": false}
{"id": 12014, "jp_tail": "して階段を見る。", "zh": "我又一次凝神去看那道楼梯。", "score": 85, "note": "「凝起眼睛」搭配生硬，按既有线（7892/9184 目を凝らす→凝神）取「凝神」", "adjudicate": false}
{"id": 12015, "jp_tail": "下に続いている。", "zh": "就像两面镜子互相映照一样，楼梯无休无止地朝下延续着。", "score": 85, "note": "「相对照出来的一样」生硬，改「互相映照」（合わせ鏡＝两面镜子对映）", "adjudicate": false}
{"id": 12016, "jp_tail": "、床が見えない。", "zh": "就算凝神去看，楼梯的前方也是一片昏暗，本该看得见的楼梯尽头、地板，都看不见。", "score": 88, "note": "", "adjudicate": false}
{"id": 12017, "jp_tail": "まさか……。", "zh": "难道说……。", "score": 92, "note": "", "adjudicate": false}
{"id": 12018, "jp_tail": "っくりと降りた。", "zh": "我又一次慢慢地走下楼梯。", "score": 90, "note": "", "adjudicate": false}
{"id": 12019, "jp_tail": "り場……踊り場。", "zh": "一步、两步、三步……转角平台……转角平台……转角平台。", "score": 92, "note": "", "adjudicate": false}
{"id": 12020, "jp_tail": "見えてこない』。", "zh": "本该通向校舍的走廊，『怎么也看不到』。", "score": 90, "note": "", "adjudicate": false}
{"id": 12021, "jp_tail": "けが続いている。", "zh": "无休无止地，一味地，只有转角平台还在延续。", "score": 85, "note": "「在不断继续」叠义（不断+继续），改「还在延续」", "adjudicate": false}
{"id": 12022, "jp_tail": "痛くなってくる。", "zh": "胸口渐渐痛了起来。", "score": 90, "note": "", "adjudicate": false}
{"id": 12023, "jp_tail": "の、ウワサ……」", "zh": "【アヤノ】「楼梯的、传闻……」", "score": 90, "note": "", "adjudicate": false}
{"id": 12024, "jp_tail": "ていることは――", "zh": "该不会，我心想。可是现实中此刻，我正在经历的事情，是――", "score": 90, "note": "", "adjudicate": false}
{"id": 12025, "jp_tail": "の上を見上げた。", "zh": "我忽然想到什么，回过身，抬头望向楼梯上方。", "score": 90, "note": "", "adjudicate": false}
{"id": 12026, "jp_tail": "あれば、上は――", "zh": "如果往下的楼梯会一直延续下去，那么上面――", "score": 90, "note": "", "adjudicate": false}
{"id": 12027, "jp_tail": "続く扉があった。", "zh": "在我所在的转角平台的正上方，那扇通往天台的门仍然还在。", "score": 85, "note": "「还是有着…门」生硬，改「那扇门仍然还在」", "adjudicate": false}
{"id": 12028, "jp_tail": "りたはずなのに。", "zh": "……明明已经往下走了那么多级楼梯。", "score": 90, "note": "", "adjudicate": false}
{"id": 12029, "jp_tail": "、屋上に戻ろう。", "zh": "……先回一趟天台吧。", "score": 92, "note": "", "adjudicate": false}
{"id": 12030, "jp_tail": "いるよりはいい。", "zh": "天台上有サクラ同学在。就算说话方式有点奇怪――就算让人心里发毛，至少也比一个人待在这里要好。", "score": 88, "note": "", "adjudicate": false}
{"id": 12031, "jp_tail": "ることもできる。", "zh": "而且，只要出到天台上，就能从那里朝下面放声呼喊。", "score": 90, "note": "", "adjudicate": false}
{"id": 12032, "jp_tail": "、なんとかなる。", "zh": "就算发生了什么不妙的事，也总有办法。", "score": 90, "note": "", "adjudicate": false}
{"id": 12033, "jp_tail": "るのは止めよう。", "zh": "总之，别再待在这里了。", "score": 90, "note": "", "adjudicate": false}
{"id": 12034, "jp_tail": "を駆け上がった。", "zh": "我把视线牢牢对着天台的门，冲上了楼梯。", "score": 90, "note": "会わせ按合わせ译（批84手记§3）", "adjudicate": false}
{"id": 12035, "jp_tail": "う嫌だったから。", "zh": "因为一移开视线，门就消失不见，那样的事我实在不想再有了。", "score": 88, "note": "", "adjudicate": false}
{"id": 12036, "jp_tail": "上の扉を開けた。", "zh": "我打开了天台的门。", "score": 90, "note": "", "adjudicate": false}
{"id": 12037, "jp_tail": "「サクラさ――」", "zh": "【アヤノ】「サクラ同――」", "score": 92, "note": "", "adjudicate": false}
{"id": 12038, "jp_tail": "は口をつぐんだ。", "zh": "话说到一半，我闭上了嘴。", "score": 90, "note": "", "adjudicate": false}
{"id": 12039, "jp_tail": "なん……で……」", "zh": "【アヤノ】「为……什么……」", "score": 92, "note": "", "adjudicate": false}
{"id": 12040, "jp_tail": "の姿はなかった。", "zh": "那里没有『サクラ同学』的身影。", "score": 90, "note": "", "adjudicate": false}
{"id": 12041, "jp_tail": "の姿もなかった。", "zh": "天台上，谁的身影都没有。", "score": 90, "note": "", "adjudicate": false}
{"id": 12042, "jp_tail": "ことができない。", "zh": "我绕着围栏一圈一圈地走着看。可是，那里谁也没有。谁的身影都看不见。", "score": 88, "note": "", "adjudicate": false}
{"id": 12043, "jp_tail": "おかしかった。", "zh": "不对劲。", "score": 92, "note": "", "adjudicate": false}
{"id": 12044, "jp_tail": "の一つしかない。", "zh": "从天台回到校内的出入口，只有我刚才进来的这一个。", "score": 88, "note": "", "adjudicate": false}
{"id": 12045, "jp_tail": "サクラさん――」", "zh": "【アヤノ】「难道说，サクラ同学――」", "score": 90, "note": "", "adjudicate": false}
{"id": 12046, "jp_tail": "地面を見てみた。", "zh": "我跑到围栏边，从那里朝下面――朝地面看去。", "score": 90, "note": "", "adjudicate": false}
{"id": 12047, "jp_tail": "少し、安心する。", "zh": "没有サクラ同学的身影。我稍微，安下心来。", "score": 88, "note": "", "adjudicate": false}
{"id": 12048, "jp_tail": "、だとしたら――", "zh": "可是，这么一来――", "score": 90, "note": "", "adjudicate": false}
{"id": 12049, "jp_tail": "消えたんだろう。", "zh": "サクラ同学到底消失到哪里去了呢。", "score": 85, "note": "删「到底」后的顿挫逗号（「到底，消失到…」→「到底消失到…」）", "adjudicate": false}
{"id": 12050, "jp_tail": "つん這いになる。", "zh": "就在那一瞬间，头又痛了起来。我再也站不住，当场趴跪在了地上。", "score": 88, "note": "", "adjudicate": false}
{"id": 12051, "jp_tail": "るものを感じる。", "zh": "感觉到有什么东西正从胃的深处涌上来。", "score": 90, "note": "", "adjudicate": false}
{"id": 12052, "jp_tail": "ような気がする。", "zh": "就算闭上眼睛，也觉得地面还在滴溜溜地打转。", "score": 90, "note": "", "adjudicate": false}
{"id": 12053, "jp_tail": "ままでいいの？」", "zh": "【サクラ】「就这样下去也可以吗？」", "score": 93, "note": "与 11973 逐字同译", "adjudicate": false}
{"id": 12054, "jp_tail": "頭の中で蘇った。", "zh": "忽然，サクラ同学的话在脑海里重新响了起来。", "score": 90, "note": "", "adjudicate": false}
{"id": 12055, "jp_tail": "い――って……。", "zh": "就这样下去也可以――是说……。", "score": 90, "note": "", "adjudicate": false}
{"id": 12056, "jp_tail": "も反響している。", "zh": "意思我不明白。只有那句话，在脑子里一遍又一遍地回响。", "score": 90, "note": "", "adjudicate": false}
{"id": 12057, "jp_tail": "をひそめている。", "zh": "到了中庭，好几位老师围着花坛站成一圈，每位老师都皱着眉头。", "score": 90, "note": "与 s2s_420 9857/9859 同族对齐", "adjudicate": false}
{"id": 12059, "jp_tail": "な空気を感じた。", "zh": "……感觉到一股讨厌的气氛。", "score": 85, "note": "嫌な空気 的「空气」在中文指称偏硬，取隐喻义「气氛」", "adjudicate": false}
{"id": 12060, "jp_tail": "、耳をすませた。", "zh": "我悄悄站到正在说话的女学生旁边，竖起了耳朵。", "score": 90, "note": "", "adjudicate": false}
{"id": 12061, "jp_tail": "年生なんだろ？」", "zh": "【女学生Ａ】「……是几年级的呢？」", "score": 90, "note": "", "adjudicate": false}
{"id": 12062, "jp_tail": "、女の子だって」", "zh": "【女学生Ｂ】「不知道。不过，听说是女孩子」", "score": 90, "note": "", "adjudicate": false}
