{"id": 13979, "jp_tail": "アヤノ】「嫌！」", "zh": "【Ayano】「不要！」", "score": 90, "note": "", "adjudicate": false}
{"id": 13980, "jp_tail": "ノの腕を掴んだ。", "zh": "我抓住了Ayano的手臂。", "score": 90, "note": "", "adjudicate": false}
{"id": 13981, "jp_tail": "身体を捻ると――", "zh": "Ayano扭动着身子――_n身体一拧――", "score": 90, "note": "", "adjudicate": false}
{"id": 13982, "jp_tail": "チ】「……ッ！」", "zh": "【Yuichi】「……唔！」", "score": 90, "note": "", "adjudicate": false}
{"id": 13983, "jp_tail": "ノの腕を掴んだ。", "zh": "我慌忙抓住了Ayano的手臂。", "score": 90, "note": "", "adjudicate": false}
{"id": 13984, "jp_tail": "ことすんだよ！」", "zh": "【Yuichi】「你为什么要做那种事啊！」", "score": 90, "note": "", "adjudicate": false}
{"id": 13985, "jp_tail": "ノ】「…………」", "zh": "【Ayano】「…………」", "score": 90, "note": "", "adjudicate": false}
{"id": 13986, "jp_tail": "ノの返事はない。", "zh": "Ayano没有回应。", "score": 90, "note": "与 12496『没有回答』jp 不全等（此处带主语），不拉平", "adjudicate": false}
{"id": 13987, "jp_tail": "腕を下げている。", "zh": "就那样闭着眼睛，一只手无力地垂着。", "score": 90, "note": "", "adjudicate": false}
{"id": 13988, "jp_tail": "見ているように。", "zh": "……简直像是在做梦一样。", "score": 90, "note": "", "adjudicate": false}
{"id": 13989, "jp_tail": "ユウイチ】「！」", "zh": "【Yuichi】「！」", "score": 90, "note": "", "adjudicate": false}
{"id": 13990, "jp_tail": "汗で滑っていく。", "zh": "手被汗浸着，一点一点地打着滑。", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
{"id": 13991, "jp_tail": "どうすんだよ！」", "zh": "【Yuichi】「别开玩笑了！ 你要是做了那种事，我该怎么办啊！」", "score": 90, "note": "", "adjudicate": false}
{"id": 13992, "jp_tail": "俺は目を細めた。", "zh": "下面吹来的风卷着灰尘扑进眼睛，我不由得眯起了眼。", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
{"id": 13993, "jp_tail": "ゆらりと揺れる。", "zh": "那一瞬间，Ayano的身体晃悠悠地摇了一下。", "score": 90, "note": "", "adjudicate": false}
{"id": 13994, "jp_tail": "（……くっ！）」", "zh": "【Yuichi】「（……唔！）」", "score": 90, "note": "", "adjudicate": false}
{"id": 13995, "jp_tail": "腕を持ち直した。", "zh": "我慌忙重新握紧了Ayano的手臂。", "score": 90, "note": "", "adjudicate": false}
{"id": 13996, "jp_tail": "ノ】「…………」", "zh": "【Ayano】「…………」", "score": 90, "note": "", "adjudicate": false}
{"id": 13997, "jp_tail": "腕を握りしめる。", "zh": "我一边发出低吼般的声音，一边紧紧攥住Ayano的手臂。", "score": 90, "note": "", "adjudicate": false}
{"id": 13998, "jp_tail": "な痛みが走った。", "zh": "右手窜过一阵刺痛。", "score": 90, "note": "", "adjudicate": false}
{"id": 13999, "jp_tail": "これは――", "zh": "这是――", "score": 90, "note": "", "adjudicate": false}
{"id": 14000, "jp_tail": "傷が、開いて――", "zh": "看Ayano笔记本时划破的伤口，裂开了――", "score": 80, "note": "『弄出的伤口』搭配弱；同一伤口 13869 已定『把手划破了』，此处取『划破的伤口』成链", "adjudicate": false}
{"id": 14001, "jp_tail": "……く……。", "zh": "……唔……", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
{"id": 14002, "jp_tail": "ままじゃあ……。", "zh": "不行，照这样下去……", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
{"id": 14003, "jp_tail": "ら、あの時の――", "zh": "不，要是在这里放弃，就会重蹈那时的――", "score": 90, "note": "", "adjudicate": false}
{"id": 14004, "jp_tail": "舞にだけは――！", "zh": "――覆辙，绝对不行――！", "score": 90, "note": "", "adjudicate": false}
{"id": 14005, "jp_tail": "ショウぉぉー！」", "zh": "【Yuichi】「可、恶——！」", "score": 90, "note": "", "adjudicate": false}
{"id": 14006, "jp_tail": "その時だった。", "zh": "就在那时。", "score": 90, "note": "", "adjudicate": false}
{"id": 14007, "jp_tail": "びくんと震えた。", "zh": "Ayano的身体猛地颤了一大下。", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
{"id": 14008, "jp_tail": "……ユウイチ？」", "zh": "【Ayano】「……Yuichi？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14009, "jp_tail": "いくのがわかる。", "zh": "能感觉到手臂上渐渐使上了力气。", "score": 90, "note": "", "adjudicate": false}
{"id": 14010, "jp_tail": "アヤ……ノっ！」", "zh": "【Yuichi】「Aya……no！」", "score": 90, "note": "", "adjudicate": false}
{"id": 14011, "jp_tail": "れ、ユウイチ？」", "zh": "【Ayano】「……咦，Yuichi？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14012, "jp_tail": "っくり下を向く。", "zh": "Ayano的视线慢慢转向下方。", "score": 90, "note": "", "adjudicate": false}
{"id": 14013, "jp_tail": "、こ……嫌……」", "zh": "【Ayano】「呀……什么，这……不要……」", "score": 90, "note": "", "adjudicate": false}
{"id": 14014, "jp_tail": "けに力いれて！」", "zh": "【Yuichi】「笨蛋别往下看！ 听好了，闭上眼睛，把力气全使在手臂上！」", "score": 90, "note": "", "adjudicate": false}
{"id": 14015, "jp_tail": "チ？ なんで？」", "zh": "【Ayano】「可是这里，是哪儿？ Yuichi？ 为什么？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14016, "jp_tail": "…いいからっ！」", "zh": "【Yuichi】「……别管那么多了！」", "score": 90, "note": "", "adjudicate": false}
{"id": 14017, "jp_tail": "「ユウイチ……」", "zh": "【Ayano】「Yuichi……」", "score": 90, "note": "", "adjudicate": false}
{"id": 14018, "jp_tail": "のバカアヤノ！」", "zh": "【Yuichi】「给我打起精神来啊你这个笨蛋Ayano！」", "score": 90, "note": "", "adjudicate": false}
{"id": 14019, "jp_tail": "、バカって――」", "zh": "【Ayano】「笨、笨蛋什么的――」", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
{"id": 14020, "jp_tail": "掴まってろよ？」", "zh": "【Yuichi】「绝对！ 绝对不许松手，听好了，我这就把你拉上去，给我抓牢了？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14021, "jp_tail": "「う、うん――」", "zh": "【Ayano】「嗯、嗯――」", "score": 90, "note": "", "adjudicate": false}
{"id": 14022, "jp_tail": "腕を全力で掴む。", "zh": "我用尽全力抓住Ayano的手臂。", "score": 90, "note": "", "adjudicate": false}
{"id": 14023, "jp_tail": "ラ入れるんだ！」", "zh": "【Yuichi】「我数『一二三』。数到『三』的时候，全身的力气给我使出来！」", "score": 90, "note": "", "adjudicate": false}
{"id": 14024, "jp_tail": "ノ】「――うん」", "zh": "【Ayano】「――嗯」", "score": 90, "note": "", "adjudicate": false}
{"id": 14025, "jp_tail": "の――さんっ！」", "zh": "【Yuichi】「预备——，一、二――三！」", "score": 90, "note": "", "adjudicate": false}
{"id": 14028, "jp_tail": "うやく止まった。", "zh": "我们就那样抱在一起在天台上滚了出去，最后总算被围栏挡住了。", "score": 90, "note": "", "adjudicate": false}
{"id": 14029, "jp_tail": "…助かったのだ。", "zh": "……得救了。", "score": 90, "note": "『……得救了。』与 8554『我得救了。』的有意分流（视点不同），维持", "adjudicate": false}
{"id": 14030, "jp_tail": "「……よかった」", "zh": "【Yuichi】「……太好了」", "score": 90, "note": "", "adjudicate": false}
{"id": 14031, "jp_tail": "「ユウイチ――」", "zh": "【Ayano】「Yuichi――」", "score": 90, "note": "", "adjudicate": false}
{"id": 14032, "jp_tail": "よ？ アヤノ？」", "zh": "【Yuichi】「你到底怎么了？ Ayano？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14033, "jp_tail": "肩に手を置いた。", "zh": "我这么说着，把手放在了Ayano的两肩上。", "score": 90, "note": "", "adjudicate": false}
{"id": 14034, "jp_tail": "……わかんない」", "zh": "【Ayano】「不、不知道。真的……不知道」", "score": 90, "note": "", "adjudicate": false}
{"id": 14035, "jp_tail": "、私教室にいて」", "zh": "【Ayano】「因为直到刚才，我都还在教室里」", "score": 90, "note": "", "adjudicate": false}
{"id": 14036, "jp_tail": "屋上に居て――」", "zh": "【Ayano】「在２年Ｂ班，和一个叫Sakura的女孩子一起请了钱仙，然后回过神来就在天台上――」", "score": 90, "note": "", "adjudicate": false}
{"id": 14037, "jp_tail": "ウイチ】「……」", "zh": "【Yuichi】「……」", "score": 90, "note": "", "adjudicate": false}
{"id": 14038, "jp_tail": "なかったはずだ。", "zh": "……教室？ 刚才我查看的时候，Ayano应该根本不在教室里才对。", "score": 90, "note": "", "adjudicate": false}
{"id": 14039, "jp_tail": "、なんだろうか。", "zh": "……是正好错过了吗。", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
{"id": 14040, "jp_tail": "ノは混乱してる。", "zh": "不，不好说。说到底，现在的Ayano正处在混乱里。", "score": 90, "note": "", "adjudicate": false}
{"id": 14041, "jp_tail": "るとは限らない。", "zh": "这么说虽然不太好，可Ayano的话未必靠得住。", "score": 90, "note": "", "adjudicate": false}
{"id": 14042, "jp_tail": "屋上にいて――」", "zh": "【Ayano】「在天台上――」", "score": 90, "note": "", "adjudicate": false}
{"id": 14043, "jp_tail": "居たんだろう？」", "zh": "【Ayano】「不知道。我为什么会在天台上呢？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14044, "jp_tail": "居たんだろう？」", "zh": "【Ayano】「为什么我会差点从天台上掉下去呢？ 为什么回过神来Yuichi就在那里呢？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14045, "jp_tail": "ため息をついた。", "zh": "我叹了口气。", "score": 90, "note": "", "adjudicate": false}
{"id": 14046, "jp_tail": "…わかったから」", "zh": "【Yuichi】「……知道了啦」", "score": 90, "note": "", "adjudicate": false}
{"id": 14047, "jp_tail": "体を抱きしめた。", "zh": "我抱住了Ayano的身体。", "score": 90, "note": "", "adjudicate": false}
{"id": 14048, "jp_tail": "……まったく。", "zh": "……真是的。", "score": 90, "note": "", "adjudicate": false}
{"id": 14049, "jp_tail": "「ユウイチ――」", "zh": "【Ayano】「Yuichi――」", "score": 90, "note": "", "adjudicate": false}
{"id": 14050, "jp_tail": "』ならいいから」", "zh": "【Yuichi】「只要你『变回原来的样子』就行了」", "score": 90, "note": "", "adjudicate": false}
{"id": 14051, "jp_tail": "たのがわかった。", "zh": "能感觉到Ayano把手绕到了我的背上。", "score": 90, "note": "", "adjudicate": false}
{"id": 14052, "jp_tail": "がと、ユウイチ」", "zh": "【Ayano】「谢啦，Yuichi」", "score": 90, "note": "", "adjudicate": false}
{"id": 14053, "jp_tail": "たし。役得役得」", "zh": "【Yuichi】「不，嘛，也没什么。你爬围栏的时候，内裤也看到了。赚到了赚到了」", "score": 70, "note": "『捞着了』偏北方口语，yuichi 口调表禁地域腔；役得取通语『赚到了』叠用", "adjudicate": false}
{"id": 14054, "jp_tail": "戻る扉を開けた。", "zh": "我，――一边揉着头――打开了从天台回校舍的门。", "score": 90, "note": "", "adjudicate": false}
{"id": 14055, "jp_tail": "ゆっくりと下る。", "zh": "两个人慢慢地走下楼梯。", "score": 90, "note": "", "adjudicate": false}
{"id": 14056, "jp_tail": "ったのかな……」", "zh": "【Ayano】「到底是什么呢……」", "score": 90, "note": "", "adjudicate": false}
{"id": 14057, "jp_tail": "ウイチ】「ん？」", "zh": "【Yuichi】「嗯？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14058, "jp_tail": "アヤノが呟いた。", "zh": "Ayano一边指着裤子右边的口袋――字条原先所在的地方，一边嘀咕道。", "score": 90, "note": "", "adjudicate": false}
{"id": 14059, "jp_tail": "だったのかな？」", "zh": "【Ayano】「……结果。天台的秘密，到底是什么呢？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14060, "jp_tail": "否定できないわ」", "zh": "【Yuichi】「不知道……不过。有什么不可思议的事牵扯在里面，这一点看来是确定的。经历了那种事……我也没法否定了」", "score": 90, "note": "", "adjudicate": false}
{"id": 14061, "jp_tail": "ノ】「……うん」", "zh": "【Ayano】「……嗯」", "score": 90, "note": "", "adjudicate": false}
{"id": 14062, "jp_tail": "教室に戻った。", "zh": "回到了教室。", "score": 90, "note": "", "adjudicate": false}
{"id": 14063, "jp_tail": "た事を説明した。", "zh": "我说明了Ayano的课桌倒在地上的事，还有我因为在意那副狼藉的样子、开始去找她的事。", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
{"id": 14064, "jp_tail": "アヤノの机……。", "zh": "Ayano的课桌……", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
{"id": 14065, "jp_tail": "、見たんだよな。", "zh": "……我可是擅自看了笔记本里面的东西啊。", "score": 90, "note": "", "adjudicate": false}
{"id": 14066, "jp_tail": "トが目に入って」", "zh": "【Yuichi】「对不起。想把课桌扶回原样的时候，看到了笔记本」", "score": 90, "note": "", "adjudicate": false}
{"id": 14067, "jp_tail": "か。中、見た？」", "zh": "【Ayano】「这样啊。里面，看了？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14068, "jp_tail": "】「……ごめん」", "zh": "【Yuichi】「……对不起」", "score": 90, "note": "", "adjudicate": false}
{"id": 14069, "jp_tail": "俺は頷いた。", "zh": "我点了点头。", "score": 90, "note": "", "adjudicate": false}
{"id": 14070, "jp_tail": "てくれたんだし」", "zh": "【Ayano】「没关系哦。如果是Yuichi的话。……而且你还救了我」", "score": 90, "note": "", "adjudicate": false}
{"id": 14071, "jp_tail": "ではないよな？」", "zh": "【Yuichi】「不过，那本笔记本上写的到底是什么啊？ 怎么说呢，那个……内容不太正常吧？」", "score": 90, "note": "", "adjudicate": false}
{"id": 14072, "jp_tail": "えてもらった事」", "zh": "【Ayano】「这个呢，是Sakura同学教给我的」", "score": 90, "note": "", "adjudicate": false}
{"id": 14073, "jp_tail": "チ】「さくら？」", "zh": "【Yuichi】「sakura？」", "score": 90, "note": "平假名『さくら』是只听到音的字形装置，豁免罗马音化，照抄", "adjudicate": false}
{"id": 14074, "jp_tail": "ん、サクラさん」", "zh": "【Ayano】「嗯，Sakura同学」", "score": 90, "note": "", "adjudicate": false}
{"id": 14075, "jp_tail": "ノが言うには――", "zh": "据Ayano说――", "score": 90, "note": "", "adjudicate": false}
{"id": 14076, "jp_tail": "したのだという。", "zh": "她和Sakura是在中庭偶然相遇，聊着聊着就意气相投了。", "score": 90, "note": "", "adjudicate": false}
{"id": 14077, "jp_tail": "めることだった。", "zh": "Sakura的兴趣，是搜集学校里流传的那些有点『不可思议的故事』和『咒语』。", "score": 90, "note": "", "adjudicate": false}
{"id": 14078, "jp_tail": "うようになった。", "zh": "Ayano对学校七大不可思议之类的故事全然不讨厌，后来常常听她讲各种各样的故事。", "score": 50, "note": "软锁行、疑似错译，请裁：教えてもらうようになった 的授受方向是 Ayano 受教（Sakura 才是传闻收藏家、故事的给出方），现译『倒豆子般讲起各种各样的故事』把讲述主语整个反成 Ayano 在讲，方向与设定相悖。建议改为受教方向；『全然不讨厌』前半维持锚点原句", "adjudicate": true, "alts": [{"zh": "Ayano对学校七大不可思议之类的故事全然不讨厌，后来从她那里倒豆子般听来了各种各样的故事。", "note": "保留原稿『倒豆子』意象，仅把方向改回受教侧"}]}
{"id": 14079, "jp_tail": "なるなんて……」", "zh": "【Ayano】「可是，居然会变成这样……」", "score": 90, "note": "", "adjudicate": false}
{"id": 14080, "jp_tail": "落としていった。", "zh": "Ayano垂着肩膀说道。", "score": 90, "note": "", "adjudicate": false}
{"id": 14081, "jp_tail": "ていた、という。", "zh": "据说刚才两个人也正在请钱仙――回过神来就在天台上，还握着我的手。", "score": 90, "note": "", "adjudicate": false}
{"id": 14082, "jp_tail": "の可能性が高い。", "zh": "从相貌上看，我在天台上遇见的少女――很可能就是Sakura。", "score": 55, "note": "软锁行请裁：§2 P5 构式壳黑名单命中『…的可能性很高』→『很可能』；该规则（2026-08-19）晚于锚点定稿，按软锁流程提请，不擅改", "adjudicate": true, "alts": [{"zh": "从相貌上看，我在天台上遇见的少女――多半就是Sakura。", "note": "口语化收法，推量语气稍轻"}]}
{"id": 14083, "jp_tail": "少女であった事。", "zh": "我在天台上遇见的『少女』就是Sakura这件事，还有留下字条的人就是那个少女这件事。", "score": 90, "note": "", "adjudicate": false}
{"id": 14084, "jp_tail": "えてしまった事。", "zh": "还有她从天台上突然消失了这件事。", "score": 90, "note": "", "adjudicate": false}
{"id": 14085, "jp_tail": "黙ってしまった。", "zh": "把天台上发生的事讲给Ayano听之后，Ayano只说了一句『Yuichi也……』，就沉默了下来。", "score": 85, "note": "§14 搭配：『说明给…听』不成话（说明不带『给…听』），改『讲给Ayano听』", "adjudicate": false}
{"id": 14086, "jp_tail": "つまり――", "zh": "也就是――", "score": 90, "note": "", "adjudicate": false}
{"id": 14087, "jp_tail": "という事になる。", "zh": "两个人都围绕着Sakura，经历了『不可思议的体验』。", "score": 90, "note": "", "adjudicate": false}
{"id": 14090, "jp_tail": "アヤノ】「……」", "zh": "【Ayano】「……」", "score": 90, "note": "", "adjudicate": false}
{"id": 14091, "jp_tail": "外を眺めている。", "zh": "Ayano默默地望着窗外。", "score": 90, "note": "", "adjudicate": false}
{"id": 14092, "jp_tail": "うしようか……。", "zh": "接下来，该怎么办呢……", "score": 90, "note": "软锁，照抄现译", "adjudicate": false}
