{"id": 987, "jp_tail": "彩野】「あ……」", "zh": "【彩野】「啊……」", "score": 88, "note": "", "adjudicate": false}
{"id": 988, "jp_tail": "【彩野】「……」", "zh": "【彩野】「……」", "score": 88, "note": "", "adjudicate": false}
