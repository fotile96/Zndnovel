{"id": 320, "jp_tail": "、家で読む場面」", "zh": "【直哉】「把从Sakura同学那里收到的信，在家里读的场面」", "score": 90, "note": "", "adjudicate": false}
{"id": 321, "jp_tail": "紙の部分は――」", "zh": "【直哉】「彩野同学，这封信的部分――」", "score": 90, "note": "", "adjudicate": false}
