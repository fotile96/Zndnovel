{"id": 9319, "jp_tail": "れるよなあ……」", "zh": "【ユウイチ】「你这家伙真是的，不感兴趣的事马上就忘啊……」", "score": 90, "note": "", "adjudicate": false}
{"id": 9320, "jp_tail": "ヤノ】「……む」", "zh": "【アヤノ】「……唔」", "score": 90, "note": "", "adjudicate": false}
