# python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# secrets (LLM API keys etc.)
.env
.env.*

# tool outputs / scratch
build/
scratch/
work/

# P2 试点车道（pilot/lanes/<lane>/）：车道根本身入库——data/forward.jsonl 与
# data/patches.jsonl 是逐批 commit 的译文正向线（spec §8 产出物），lane.json
# 与 pilot-manifest.json 是冻结基准，都不能被忽略。只忽略车道内的中间产物：
# work/ 子目录、skeleton/+glossary/ 冻结拷贝（体量大，可由 manifest 哈希追溯）、
# data/ 下指向仓库同一份文件的符号链接。
pilot/lanes/*/work/
pilot/lanes/*/skeleton/
pilot/lanes/*/glossary/
pilot/lanes/*/data/*
!pilot/lanes/*/data/forward.jsonl
!pilot/lanes/*/data/patches.jsonl
# notes/ 是 spec §8 产出物「两份术语提案清单」——需先放行目录本身，
# 否则目录被 data/* 排除后其内文件的否定规则不生效（git 的目录排除优先规则）
!pilot/lanes/*/data/notes/
!pilot/lanes/*/data/notes/*.md
