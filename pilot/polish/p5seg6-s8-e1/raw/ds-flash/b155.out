{"id": 16753, "jp_tail": "、『戻る』んだ」", "zh": "【Yuichi】「彩野，『回去』」", "score": 90, "note": "", "adjudicate": false}
{"id": 16754, "jp_tail": "】「ユウイ――」", "zh": "【Ayano】「Yui――」", "score": 90, "note": "", "adjudicate": false}
{"id": 16755, "jp_tail": "の言葉を……！」", "zh": "【Yuichi】「Ayano，相信我。不是任何别人的话，而是『我』的话……！」", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16756, "jp_tail": "ウ……イチ……」", "zh": "【Ayano】「Yu……ichi……」", "score": 90, "note": "", "adjudicate": false}
{"id": 16757, "jp_tail": "チ】「アヤノ！」", "zh": "【Yuichi】「Ayano！」", "score": 90, "note": "", "adjudicate": false}
{"id": 16758, "jp_tail": "「ユウイチ――」", "zh": "【Ayano】「Yuichi――」", "score": 90, "note": "", "adjudicate": false}
{"id": 16760, "jp_tail": "ノの腕を掴んだ。", "zh": "我抓住了Ayano的手臂。", "score": 90, "note": "坠落抓手句族；与 s4s 13980 同文，逐字照抄", "adjudicate": false}
{"id": 16761, "jp_tail": "身体を捻ると――", "zh": "Ayano扭动着身子――_n身体一拧――", "score": 90, "note": "", "adjudicate": false}
{"id": 16762, "jp_tail": "ノの腕を掴んだ。", "zh": "我慌忙抓住了Ayano的手臂。", "score": 90, "note": "坠落抓手句族；与 s4s 13983 同文，逐字照抄", "adjudicate": false}
{"id": 16763, "jp_tail": "チ】「アヤノ！」", "zh": "【Yuichi】「Ayano！」", "score": 90, "note": "", "adjudicate": false}
{"id": 16764, "jp_tail": "を抱きかかえる。", "zh": "虽然险些失去平衡，还是一把抱住了Ayano。", "score": 90, "note": "", "adjudicate": false}
{"id": 16765, "jp_tail": "んだ、アヤノ！」", "zh": "【Yuichi】「撑住啊，Ayano！」", "score": 90, "note": "", "adjudicate": false}
{"id": 16766, "jp_tail": "「ユウイチ……」", "zh": "【Ayano】「Yuichi……」", "score": 90, "note": "", "adjudicate": false}
{"id": 16767, "jp_tail": "腕を下げている。", "zh": "就那样闭着眼睛，一只手无力地垂着。", "score": 90, "note": "", "adjudicate": false}
{"id": 16768, "jp_tail": "見ているように。", "zh": "……简直像是在做梦一样。", "score": 90, "note": "", "adjudicate": false}
{"id": 16769, "jp_tail": "汗で滑っていく。", "zh": "手被汗浸着，一点一点地打着滑。", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16770, "jp_tail": "俺は目を細めた。", "zh": "下面吹来的风卷着灰尘扑进眼睛，我不由得眯起了眼。", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16771, "jp_tail": "叩きつけられる。", "zh": "Ayano的身体又一次被风掀动，撞在了校舍上。", "score": 90, "note": "", "adjudicate": false}
{"id": 16772, "jp_tail": "げに眉を寄せる。", "zh": "Ayano痛苦地皱起眉头。", "score": 90, "note": "", "adjudicate": false}
{"id": 16773, "jp_tail": "ノ】「…………」", "zh": "【Ayano】「…………」", "score": 90, "note": "", "adjudicate": false}
{"id": 16774, "jp_tail": "ます様子がない。", "zh": "可是，她并没有要醒来的样子。", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16775, "jp_tail": "また、名前を――", "zh": "然后又一次，把那个名字――", "score": 90, "note": "", "adjudicate": false}
{"id": 16776, "jp_tail": "、名前を、呼ぶ。", "zh": "一次又一次，_n把那个名字，_n呼唤出来。", "score": 90, "note": "", "adjudicate": false}
{"id": 16777, "jp_tail": "「ユウイチ……」", "zh": "【Ayano】「Yuichi……」", "score": 90, "note": "", "adjudicate": false}
{"id": 16778, "jp_tail": "離すもんか。", "zh": "才不会松手。", "score": 90, "note": "坠落抓手句族；与 s7f 16375 同文，逐字照抄", "adjudicate": false}
{"id": 16779, "jp_tail": "】「ユウイ――」", "zh": "【Ayano】「Yui――」", "score": 90, "note": "", "adjudicate": false}
{"id": 16780, "jp_tail": "離さない。", "zh": "不会松手。", "score": 90, "note": "坠落抓手句族；与 s7f 同文，逐字照抄", "adjudicate": false}
{"id": 16781, "jp_tail": "ウ……イチ……」", "zh": "【Ayano】「Yu……ichi……」", "score": 90, "note": "", "adjudicate": false}
{"id": 16782, "jp_tail": "うと離すものか。", "zh": "绝对，无论发生什么都不会松手。", "score": 90, "note": "坠落抓手句族；与 s7f 16377 同文，逐字照抄", "adjudicate": false}
{"id": 16783, "jp_tail": "「ユウイチ――」", "zh": "【Ayano】「Yuichi――」", "score": 90, "note": "", "adjudicate": false}
{"id": 16784, "jp_tail": "今こそ――", "zh": "就是现在――", "score": 90, "note": "", "adjudicate": false}
{"id": 16785, "jp_tail": "を告げる時≫だ。", "zh": "就是现在，≪正是我向Ayano说出心意的时刻≫。", "score": 90, "note": "", "adjudicate": false}
{"id": 16786, "jp_tail": "息を吸い込み――", "zh": "我吸了一口气――", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16788, "jp_tail": "きだ。誰よりも」", "zh": "【Yuichi】「我喜欢Ayano。比谁都喜欢」", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16789, "jp_tail": "ヤノに告白した。", "zh": "我向Ayano告白了。", "score": 90, "note": "", "adjudicate": false}
{"id": 16790, "jp_tail": "野……さんっ！」", "zh": "【Yuichi】「彩野……同学！」", "score": 90, "note": "演出：说话人【Yuichi】喊出现实层汉字名「彩野」，原文如此，不修复", "adjudicate": false}
{"id": 16791, "jp_tail": "もう一度開いた。", "zh": "Ayano的身体颤抖起来。她慢慢地闭上眼睛，又一次睁开。", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16792, "jp_tail": "にいるのは――」", "zh": "【Ayano】「Yuichi……是Yuichi吗？ 在那里的，是――」", "score": 90, "note": "", "adjudicate": false}
{"id": 16793, "jp_tail": "うだよ、アヤノ」", "zh": "【Yuichi】「是啊，Ayano」", "score": 90, "note": "", "adjudicate": false}
{"id": 16794, "jp_tail": "の向こう側』へ」", "zh": "【Yuichi】「回去吧。到另一侧去。到『围栏的另一侧』去」", "score": 90, "note": "", "adjudicate": false}
{"id": 16795, "jp_tail": "力が戻って来る。", "zh": "Ayano的手上，重新有了力气。", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16796, "jp_tail": "はゆっくりと――", "zh": "Ayano慢慢地――", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16797, "jp_tail": "ノ】「――うん」", "zh": "【Ayano】「――嗯」", "score": 90, "note": "", "adjudicate": false}
{"id": 16798, "jp_tail": "っくりと頷いた。", "zh": "非常缓慢地点了点头。", "score": 90, "note": "", "adjudicate": false}
{"id": 16799, "jp_tail": "へと引き上げた。", "zh": "我紧紧攥住Ayano的手，使出浑身的力气，把Ayano拉上了≪这一侧≫。", "score": 90, "note": "坠落抓手句族收束；こちら側→这一侧 与 向こう側→另一侧 成对（v13），≪≫ 原样", "adjudicate": false}
{"id": 16800, "jp_tail": "く染まっていた。", "zh": "太阳已经落下，天台染上一片苍白。", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16801, "jp_tail": "を照らしている。", "zh": "月光照着两个人。", "score": 90, "note": "", "adjudicate": false}
{"id": 16802, "jp_tail": "生徒】「ね……」", "zh": "【女学生】「呐……」", "score": 90, "note": "", "adjudicate": false}
{"id": 16803, "jp_tail": "男子生徒】「ん」", "zh": "【男学生】「嗯」", "score": 90, "note": "", "adjudicate": false}
{"id": 16804, "jp_tail": "だったのかな？」", "zh": "【女学生】「谁都没见过的晚霞，那到底是什么呢？」", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16805, "jp_tail": "子生徒】「んー」", "zh": "【男学生】「唔——」", "score": 90, "note": "", "adjudicate": false}
{"id": 16806, "jp_tail": "俺は考える。", "zh": "我思考着。", "score": 90, "note": "", "adjudicate": false}
{"id": 16807, "jp_tail": "の言葉の意味を。", "zh": "她那句话的意思。", "score": 90, "note": "", "adjudicate": false}
{"id": 16808, "jp_tail": "女子生徒】「ね」", "zh": "【女学生】「呐」", "score": 90, "note": "", "adjudicate": false}
{"id": 16809, "jp_tail": "男子生徒】「ん」", "zh": "【男学生】「嗯」", "score": 90, "note": "", "adjudicate": false}
{"id": 16810, "jp_tail": "に帰りたくない」", "zh": "【女学生】「有点……犯困了。可是呢，我还，不想回家」", "score": 90, "note": "", "adjudicate": false}
{"id": 16811, "jp_tail": "いてあげるから」", "zh": "【男学生】「稍微休息一会儿就好。没关系，我会守着你的」", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16812, "jp_tail": "子生徒】「うん」", "zh": "【女学生】「嗯」", "score": 90, "note": "", "adjudicate": false}
{"id": 16813, "jp_tail": "と目をつむった。", "zh": "她这么说着，闭上了眼睛。", "score": 90, "note": "", "adjudicate": false}
{"id": 16814, "jp_tail": "息をたて始める。", "zh": "过了一会儿，就开始发出睡得香甜的呼吸声。", "score": 90, "note": "软锁，逐字沿用锚点定译", "adjudicate": false}
{"id": 16815, "jp_tail": "のを待っていた。", "zh": "我一边望着她的睡脸，一边等着朝阳升起。", "score": 90, "note": "", "adjudicate": false}
{"id": 17038, "jp_tail": "が完結しました。", "zh": "故事模式：章节８已完结。", "score": 90, "note": "", "adjudicate": false}
{"id": 0, "note": "批末说明：全批 62 行为 s8s 天台救援段，逐行对照 §0 取义（想いを告げる/告白 分治、バランスを崩す→失去平衡、こちら側/向こう側 成对）、§14 搭配（腕→手臂、松手句族）、§15 重复（ユウイ―― 断音逐字保留）、§16 歧义、§13 段级密度（短句切分节奏已合，无语气词堆叠）；坠落抓手句族与 s4s/s7f 已入线形逐字一致，全部维持现译。"}
