{"id": 3677, "jp_tail": "を作ってあるよ」", "zh": "【直哉】「……。嗯。卡片我已经做好了哦」", "score": 88, "note": "", "adjudicate": false}
{"id": 3678, "jp_tail": "彩野】「あ――」", "zh": "【彩野】「啊――」", "score": 88, "note": "", "adjudicate": false}
