{"id": 11953, "jp_tail": "＊】「アヤノ！」", "zh": "【＊＊＊】「アヤノ！」", "score": 95, "note": "", "adjudicate": false}
{"id": 11954, "jp_tail": "アヤノ】「！？」", "zh": "【アヤノ】「！？」", "score": 95, "note": "", "adjudicate": false}
{"id": 11955, "jp_tail": "この声は――！？", "zh": "这个声音是――！？", "score": 95, "note": "", "adjudicate": false}
{"id": 12072, "jp_tail": "へえ、階段ねえ」", "zh": "【ユウイチ】「哦——，楼梯啊」", "score": 92, "note": "", "adjudicate": false}
{"id": 12073, "jp_tail": "ヤノ】「……む」", "zh": "【アヤノ】「……唔」", "score": 95, "note": "", "adjudicate": false}
{"id": 12074, "jp_tail": "ろす格好になる。", "zh": "我一口气冲上楼梯，站到了比ユウイチ高５级台阶的位置。在这个位置上，就成了俯视ユウイチ的姿势。", "score": 90, "note": "全角５按批内统一保留", "adjudicate": false}
{"id": 12075, "jp_tail": "方を見ていった。", "zh": "我回过头去，望着ユウイチ那边说道。", "score": 90, "note": "", "adjudicate": false}
{"id": 12076, "jp_tail": "ウワサがあるの」", "zh": "【アヤノ】「这里啊，有一个不可思议的传闻哦」", "score": 90, "note": "", "adjudicate": false}
{"id": 12077, "jp_tail": "チ】「ウワサ？」", "zh": "【ユウイチ】「传闻？」", "score": 95, "note": "", "adjudicate": false}
{"id": 12078, "jp_tail": "聞いたんだって」", "zh": "【アヤノ】「对。听说呢，就在几年前，有很多学生从这道楼梯那边听见了奇怪的叫喊声哦」", "score": 86, "note": "", "adjudicate": false}
{"id": 12080, "jp_tail": "あ……お前――」", "zh": "【ユウイチ】「又来了啊……你这家伙――」", "score": 92, "note": "", "adjudicate": false}
{"id": 12081, "jp_tail": "ノ】「待った！」", "zh": "【アヤノ】「打住！」", "score": 95, "note": "", "adjudicate": false}
{"id": 12082, "jp_tail": "を遮っていった。", "zh": "我打断ユウイチ的话说道。", "score": 92, "note": "", "adjudicate": false}
{"id": 12083, "jp_tail": "たいんでしょ？」", "zh": "【アヤノ】「反正你又想说什么传闻啦、错觉啦、骗人的啦，对吧？」", "score": 88, "note": "", "adjudicate": false}
{"id": 12084, "jp_tail": "チ】「……むぐ」", "zh": "【ユウイチ】「……唔咕」", "score": 95, "note": "", "adjudicate": false}
{"id": 12085, "jp_tail": "いるんだって！」", "zh": "【アヤノ】「可是不是那样的！ 听说真的有学生听见过这个声音哦！」", "score": 88, "note": "", "adjudicate": false}
{"id": 12086, "jp_tail": "チ】「本当に？」", "zh": "【ユウイチ】「真的？」", "score": 95, "note": "", "adjudicate": false}
{"id": 12090, "jp_tail": "その時――", "zh": "就在那时――", "score": 95, "note": "原文剥离控制码后仅 5 字，取全串（W3 工装误报，勿改）", "adjudicate": false}
{"id": 12091, "jp_tail": "ウイチ】「あ！」", "zh": "【ユウイチ】「啊！」", "score": 95, "note": "", "adjudicate": false}
{"id": 12092, "jp_tail": "叫び声を上げた。", "zh": "突然，ユウイチ发出了很大的一声叫喊。", "score": 92, "note": "", "adjudicate": false}
{"id": 12093, "jp_tail": " どうしたの？」", "zh": "【アヤノ】「什、什么！？ 怎么了？」", "score": 92, "note": "", "adjudicate": false}
{"id": 12094, "jp_tail": "ヤノ！ お……」", "zh": "【ユウイチ】「アヤノ！ 你……」", "score": 92, "note": "", "adjudicate": false}
{"id": 12095, "jp_tail": "な、なに……？」", "zh": "【アヤノ】「诶？ 什、什么……？」", "score": 92, "note": "", "adjudicate": false}
{"id": 12096, "jp_tail": "前……後ろ……」", "zh": "【ユウイチ】「你……后面……」", "score": 95, "note": "", "adjudicate": false}
{"id": 12097, "jp_tail": "がぞくりとした。", "zh": "难道说……。背脊一阵发凉。", "score": 92, "note": "", "adjudicate": false}
{"id": 12098, "jp_tail": "ノ……見ろ……」", "zh": "【ユウイチ】「アヤノ……你看……」", "score": 92, "note": "", "adjudicate": false}
{"id": 12099, "jp_tail": "ろを振り返った。", "zh": "我慢慢地回过头去。", "score": 95, "note": "", "adjudicate": false}
{"id": 12100, "jp_tail": "私は後ろを向く。", "zh": "就像一台快要坏掉的机器人，我一边生硬地挪动着身体，一边转向后面。", "score": 86, "note": "", "adjudicate": false}
{"id": 12101, "jp_tail": "】「なんで……」", "zh": "【ユウイチ】「为什么……」", "score": 95, "note": "", "adjudicate": false}
{"id": 12102, "jp_tail": "イチはつぶやく。", "zh": "ユウイチ嘀咕着。", "score": 95, "note": "", "adjudicate": false}
{"id": 12103, "jp_tail": "何か……いる？」", "zh": "【アヤノ】「我、我的后面……有什么……在吗？」", "score": 90, "note": "", "adjudicate": false}
{"id": 12104, "jp_tail": "】「そこに……」", "zh": "【ユウイチ】「就在那里……」", "score": 95, "note": "", "adjudicate": false}
{"id": 12105, "jp_tail": "向こうを指した。", "zh": "ユウイチ慢慢地抬起右手，用食指指向了我肩膀的另一侧。", "score": 90, "note": "", "adjudicate": false}
{"id": 12106, "jp_tail": "な……なに……」", "zh": "【アヤノ】「什……什么……」", "score": 95, "note": "", "adjudicate": false}
{"id": 12107, "jp_tail": "を凝らしてみる。", "zh": "我试着凝神细看。", "score": 92, "note": "", "adjudicate": false}
{"id": 12108, "jp_tail": "は何も映らない。", "zh": "可是，我的眼里什么也没有映出来。", "score": 92, "note": "", "adjudicate": false}
{"id": 12109, "jp_tail": "に、ユウイチ！」", "zh": "【アヤノ】「怎、怎么样？ 是什么啊，ユウイチ！」", "score": 90, "note": "", "adjudicate": false}
{"id": 12110, "jp_tail": "なにも……ない」", "zh": "【ユウイチ】「什么……也没有」", "score": 95, "note": "", "adjudicate": false}
{"id": 12111, "jp_tail": "アヤノ】「……」", "zh": "【アヤノ】「……」", "score": 95, "note": "", "adjudicate": false}
{"id": 12112, "jp_tail": "ことだ、アヤノ」", "zh": "【ユウイチ】「总之呢，就是别被奇怪的传闻牵着鼻子走，アヤノ」", "score": 90, "note": "", "adjudicate": false}
{"id": 12113, "jp_tail": "……こ……この」", "zh": "【アヤノ】「……你……你这」", "score": 92, "note": "", "adjudicate": false}
{"id": 12114, "jp_tail": "あるまいし……」", "zh": "【ユウイチ】「什么？ 楼梯的传闻？ 又不是小学生……」", "score": 92, "note": "", "adjudicate": false}
{"id": 12115, "jp_tail": "…あんたねえ！」", "zh": "【アヤノ】「你……你这家伙……我说你啊！」", "score": 92, "note": "", "adjudicate": false}
{"id": 12116, "jp_tail": "よな、そんなの」", "zh": "【ユウイチ】「嘛，那种东西，怎么可能会有嘛」", "score": 90, "note": "", "adjudicate": false}
{"id": 12117, "jp_tail": "】「殴るわよ！」", "zh": "【アヤノ】「我要揍你了！」", "score": 95, "note": "", "adjudicate": false}
{"id": 12118, "jp_tail": "体を横にずらす。", "zh": "ユウイチ轻巧地把身体往旁边一闪。", "score": 92, "note": "", "adjudicate": false}
{"id": 12119, "jp_tail": "避け……って！」", "zh": "【アヤノ】「哇！ 干嘛躲……哎呀！」", "score": 92, "note": "", "adjudicate": false}
{"id": 12120, "jp_tail": "れるかってーの」", "zh": "【ユウイチ】「谁能一次又一次挨你揍啊」", "score": 90, "note": "", "adjudicate": false}
{"id": 12121, "jp_tail": "崩してしまった。", "zh": "朝着空处挥下手臂的我，身体一下子大大地失去了平衡。", "score": 86, "note": "", "adjudicate": false}
{"id": 12122, "jp_tail": "だ、だめっ……」", "zh": "【アヤノ】「不、不行……」", "score": 95, "note": "", "adjudicate": false}
{"id": 12123, "jp_tail": "段が迫ってくる。", "zh": "楼梯朝着我的眼前逼近过来。", "score": 92, "note": "", "adjudicate": false}
{"id": 12124, "jp_tail": "このままでは――", "zh": "不行，再这样下去――", "score": 92, "note": "", "adjudicate": false}
{"id": 12125, "jp_tail": "「……ユウイチ」", "zh": "【アヤノ】「……ユウイチ」", "score": 95, "note": "", "adjudicate": false}
{"id": 12126, "jp_tail": "に手がでるのな」", "zh": "【ユウイチ】「……真是的。你这家伙，嘴还没动手就先上了啊」", "score": 90, "note": "", "adjudicate": false}
{"id": 12127, "jp_tail": "、……ありがと」", "zh": "【アヤノ】「那、那个……呃……啊，……谢谢」", "score": 90, "note": "ありがと 短形→谢谢", "adjudicate": false}
{"id": 12130, "jp_tail": "んだからねっ！」", "zh": "【アヤノ】「可……可是！ 归根到底，是ユウイチ你闹着玩才不对的嘛！」", "score": 90, "note": "", "adjudicate": false}
{"id": 12131, "jp_tail": "せんでしたって」", "zh": "【ユウイチ】「……好啦好啦，都说了对不起了嘛」", "score": 92, "note": "", "adjudicate": false}
{"id": 12132, "jp_tail": "ヤノ】「……む」", "zh": "【アヤノ】「……唔」", "score": 95, "note": "", "adjudicate": false}
{"id": 12133, "jp_tail": "まってるわけ？」", "zh": "【ユウイチ】「……那么。你打算揪着我的胸口不放到什么时候啊？」", "score": 90, "note": "揪着胸口（已裁定句）", "adjudicate": false}
{"id": 12134, "jp_tail": "ヤノ】「あっ！」", "zh": "【アヤノ】「啊！」", "score": 95, "note": "", "adjudicate": false}
{"id": 12135, "jp_tail": "ユウイチと……。", "zh": "我，和ユウイチ……。", "score": 95, "note": "", "adjudicate": false}
