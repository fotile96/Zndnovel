{"id": 3616, "jp_tail": "なんだけど――」", "zh": "【彩野】「直哉君，关于这里这个场面――」", "score": 88, "note": "", "adjudicate": false}
{"id": 3617, "jp_tail": "い結末……だね」", "zh": "【直哉】「Bad End……不好的结局……是吧」", "score": 88, "note": "", "adjudicate": false}
