{"id": 27, "jp_tail": "「教室に来たよ」", "zh": "【アヤノ】「到教室了哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 28, "jp_tail": "たちの教室だね」", "zh": "【アヤノ】「是我们的教室呢」", "score": 92, "note": "", "adjudicate": false}
{"id": 29, "jp_tail": "に戻ってきたよ」", "zh": "【アヤノ】「回到教室了哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 30, "jp_tail": "「廊下に出たよ」", "zh": "【アヤノ】「来到走廊上了哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 31, "jp_tail": "廊下は静かだね」", "zh": "【アヤノ】「放学后的走廊真安静呢」", "score": 92, "note": "", "adjudicate": false}
{"id": 32, "jp_tail": "ことができるよ」", "zh": "【アヤノ】「走廊。从这里的窗户能看到中庭和天台哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 33, "jp_tail": "が気持ちいいな」", "zh": "【アヤノ】「天台。风吹着好舒服呀」", "score": 92, "note": "", "adjudicate": false}
{"id": 34, "jp_tail": "だれもいないね」", "zh": "【アヤノ】「上到天台了，不过……一个人也没有呢」", "score": 92, "note": "", "adjudicate": false}
{"id": 35, "jp_tail": "けしちゃいそう」", "zh": "【アヤノ】「到天台了哦。待久了好像会晒黑呢」", "score": 92, "note": "", "adjudicate": false}
{"id": 36, "jp_tail": "、中庭に出たよ」", "zh": "【アヤノ】「换好鞋，来到中庭了哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 37, "jp_tail": "今日も暑いなあ」", "zh": "【アヤノ】「中庭。今天也好热呀」", "score": 92, "note": "", "adjudicate": false}
{"id": 38, "jp_tail": "ば涼しいかな？」", "zh": "【アヤノ】「是中庭呢。躲到那边树下的阴影里，会不会凉快点呀？」", "score": 92, "note": "", "adjudicate": false}
{"id": 39, "jp_tail": "ールが見えるね」", "zh": "【アヤノ】「到操场了哦。能看到北校舍和体育馆、网球场和游泳池呢」", "score": 92, "note": "", "adjudicate": false}
{"id": 40, "jp_tail": "はあっついなあ」", "zh": "【アヤノ】「来到操场上了，不过……这个季节果然还是热得不行呀」", "score": 92, "note": "", "adjudicate": false}
{"id": 41, "jp_tail": "「校庭に出たよ」", "zh": "【アヤノ】「来到操场上了哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 42, "jp_tail": "保健室に来たよ」", "zh": "【アヤノ】「到保健室了哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 43, "jp_tail": "のにおいがする」", "zh": "【アヤノ】「保健室……有一股药的味道」", "score": 92, "note": "", "adjudicate": false}
{"id": 44, "jp_tail": "ような気がする」", "zh": "【アヤノ】「是保健室呢。和别的教室比起来，总觉得气温要低一点」", "score": 92, "note": "", "adjudicate": false}
{"id": 45, "jp_tail": "感じがするなあ」", "zh": "【アヤノ】「美术室。和别的教室比起来，果然感觉气氛不太一样呀」", "score": 92, "note": "", "adjudicate": false}
{"id": 46, "jp_tail": "】「美術室だよ」", "zh": "【アヤノ】「是美术室哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 47, "jp_tail": "作品が見えるね」", "zh": "【アヤノ】「到美术室了哦。能看到做到一半的作品呢」", "score": 92, "note": "", "adjudicate": false}
{"id": 48, "jp_tail": "音楽室に来たよ」", "zh": "【アヤノ】「到音乐室了哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 49, "jp_tail": "も聞こえないね」", "zh": "【アヤノ】「音乐室。里面是隔音的，所以走廊上的说话声都听不见呢」", "score": 92, "note": "", "adjudicate": false}
{"id": 50, "jp_tail": "みようかあ……」", "zh": "【アヤノ】「音乐室。要不要试着演奏点什么呢……」", "score": 92, "note": "", "adjudicate": false}
{"id": 51, "jp_tail": "図書室に来たよ」", "zh": "【アヤノ】「到图书室了哦」", "score": 92, "note": "", "adjudicate": false}
{"id": 52, "jp_tail": "にしないと……」", "zh": "【アヤノ】「是图书室呢。这里的话，果然还是得安静点……」", "score": 92, "note": "", "adjudicate": false}
{"id": 53, "jp_tail": "こうかなあ……」", "zh": "【アヤノ】「图书室。要不要借点什么走呢……」", "score": 92, "note": "", "adjudicate": false}
{"id": 54, "jp_tail": "そろ、時間かな」", "zh": "【アヤノ】「差不多，到时间了吧」", "score": 92, "note": "", "adjudicate": false}
{"id": 55, "jp_tail": "わせの時間かも」", "zh": "【アヤノ】「啊，差不多该到碰面的时间了」", "score": 92, "note": "", "adjudicate": false}
{"id": 56, "jp_tail": "そろ時間みたい」", "zh": "【アヤノ】「嗯。好像差不多到时间了」", "score": 92, "note": "", "adjudicate": false}
