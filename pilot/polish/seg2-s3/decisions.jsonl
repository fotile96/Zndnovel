{"id": 11495, "verdict": "edit", "chosen_channel": "fable-wf", "edited_zh": "サクラ摇了摇头。长长的头发柔顺地摇曳。", "reason_code": "术语", "ts": "2026-08-10T23:40:05+0800"}
