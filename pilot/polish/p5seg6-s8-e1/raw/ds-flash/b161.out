{"id": 4241, "jp_tail": "の人』ね。ふふ」", "zh": "【Yukari】「原来如此。『那个人』啊。呵呵」", "score": 95, "note": "", "adjudicate": false}
{"id": 4242, "jp_tail": "……気になる？」", "zh": "【Yukari】「……很在意？」", "score": 95, "note": "", "adjudicate": false}
