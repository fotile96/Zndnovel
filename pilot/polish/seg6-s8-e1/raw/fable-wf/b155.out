{"id": 16753, "jp_tail": "、『戻る』んだ」", "zh": "【ユウイチ】「彩野，『回去』」", "score": 88, "note": "", "adjudicate": false}
{"id": 16754, "jp_tail": "】「ユウイ――」", "zh": "【アヤノ】「ユウイ――」", "score": 88, "note": "", "adjudicate": false}
{"id": 16755, "jp_tail": "の言葉を……！」", "zh": "【ユウイチ】「アヤノ，你要相信。不是任何别人的话，是『我』的话……！」", "score": 88, "note": "", "adjudicate": false}
{"id": 16756, "jp_tail": "ウ……イチ……」", "zh": "【アヤノ】「ユウ……イチ……」", "score": 88, "note": "", "adjudicate": false}
{"id": 16757, "jp_tail": "チ】「アヤノ！」", "zh": "【ユウイチ】「アヤノ！」", "score": 88, "note": "", "adjudicate": false}
{"id": 16758, "jp_tail": "「ユウイチ――」", "zh": "【アヤノ】「ユウイチ――」", "score": 88, "note": "", "adjudicate": false}
{"id": 16760, "jp_tail": "ノの腕を掴んだ。", "zh": "我抓住了アヤノ的手臂。", "score": 88, "note": "", "adjudicate": false}
{"id": 16761, "jp_tail": "身体を捻ると――", "zh": "アヤノ扭动着身子――_n身体一拧――", "score": 88, "note": "", "adjudicate": false}
{"id": 16762, "jp_tail": "ノの腕を掴んだ。", "zh": "我慌忙抓住了アヤノ的手臂。", "score": 88, "note": "", "adjudicate": false}
{"id": 16763, "jp_tail": "チ】「アヤノ！」", "zh": "【ユウイチ】「アヤノ！」", "score": 88, "note": "", "adjudicate": false}
{"id": 16764, "jp_tail": "を抱きかかえる。", "zh": "虽然险些失去平衡，还是一把抱住了アヤノ。", "score": 88, "note": "", "adjudicate": false}
{"id": 16765, "jp_tail": "んだ、アヤノ！」", "zh": "【ユウイチ】「撑住啊，アヤノ！」", "score": 88, "note": "", "adjudicate": false}
{"id": 16766, "jp_tail": "「ユウイチ……」", "zh": "【アヤノ】「ユウイチ……」", "score": 88, "note": "", "adjudicate": false}
{"id": 16767, "jp_tail": "腕を下げている。", "zh": "就那样闭着眼睛，一只手无力地垂着。", "score": 88, "note": "", "adjudicate": false}
{"id": 16768, "jp_tail": "見ているように。", "zh": "……简直像是在做梦一样。", "score": 88, "note": "", "adjudicate": false}
{"id": 16770, "jp_tail": "俺は目を細めた。", "zh": "从下面吹上来的风把灰尘卷进眼睛，我不由得眯起了眼。", "score": 88, "note": "", "adjudicate": false}
{"id": 16771, "jp_tail": "叩きつけられる。", "zh": "アヤノ的身体又一次被风掀动，撞在了校舍上。", "score": 88, "note": "", "adjudicate": false}
{"id": 16772, "jp_tail": "げに眉を寄せる。", "zh": "アヤノ痛苦地皱起眉头。", "score": 88, "note": "", "adjudicate": false}
{"id": 16773, "jp_tail": "ノ】「…………」", "zh": "【アヤノ】「…………」", "score": 88, "note": "", "adjudicate": false}
{"id": 16774, "jp_tail": "ます様子がない。", "zh": "可是，没有要醒过来的样子。", "score": 88, "note": "", "adjudicate": false}
{"id": 16775, "jp_tail": "また、名前を――", "zh": "然后又一次，把那个名字――", "score": 88, "note": "", "adjudicate": false}
{"id": 16776, "jp_tail": "、名前を、呼ぶ。", "zh": "一次又一次，_n把那个名字，_n呼唤出来。", "score": 88, "note": "", "adjudicate": false}
{"id": 16777, "jp_tail": "「ユウイチ……」", "zh": "【アヤノ】「ユウイチ……」", "score": 88, "note": "", "adjudicate": false}
{"id": 16778, "jp_tail": "離すもんか。", "zh": "才不会松手。", "score": 88, "note": "", "adjudicate": false}
{"id": 16779, "jp_tail": "】「ユウイ――」", "zh": "【アヤノ】「ユウイ――」", "score": 88, "note": "", "adjudicate": false}
{"id": 16780, "jp_tail": "離さない。", "zh": "不会松手。", "score": 88, "note": "", "adjudicate": false}
{"id": 16781, "jp_tail": "ウ……イチ……」", "zh": "【アヤノ】「ユウ……イチ……」", "score": 88, "note": "", "adjudicate": false}
{"id": 16782, "jp_tail": "うと離すものか。", "zh": "绝对，无论发生什么都不会松手。", "score": 88, "note": "", "adjudicate": false}
{"id": 16783, "jp_tail": "「ユウイチ――」", "zh": "【アヤノ】「ユウイチ――」", "score": 88, "note": "", "adjudicate": false}
{"id": 16784, "jp_tail": "今こそ――", "zh": "就是现在――", "score": 88, "note": "", "adjudicate": false}
{"id": 16785, "jp_tail": "を告げる時≫だ。", "zh": "就是现在，≪正是我向アヤノ说出心意的时刻≫。", "score": 88, "note": "", "adjudicate": false}
{"id": 16786, "jp_tail": "息を吸い込み――", "zh": "我吸了一口气――", "score": 70, "note": "", "adjudicate": false}
{"id": 16788, "jp_tail": "きだ。誰よりも」", "zh": "【ユウイチ】「我喜欢アヤノ。比谁都喜欢」", "score": 92, "note": "", "adjudicate": false}
{"id": 16789, "jp_tail": "ヤノに告白した。", "zh": "我向アヤノ告白了。", "score": 88, "note": "", "adjudicate": false}
{"id": 16790, "jp_tail": "野……さんっ！」", "zh": "【ユウイチ】「彩野……同学！」", "score": 88, "note": "", "adjudicate": false}
{"id": 16791, "jp_tail": "もう一度開いた。", "zh": "アヤノ的身体颤抖起来。她慢慢地闭上眼睛，又一次睁开。", "score": 72, "note": "叙述行内同名紧邻复现，第二处换代词（polish.md §5(d)）；对白呼名位未动。", "adjudicate": false}
{"id": 16792, "jp_tail": "にいるのは――」", "zh": "【アヤノ】「ユウイチ……是ユウイチ吗？ 在那里的，是――」", "score": 88, "note": "", "adjudicate": false}
{"id": 16793, "jp_tail": "うだよ、アヤノ」", "zh": "【ユウイチ】「是啊，アヤノ」", "score": 88, "note": "", "adjudicate": false}
{"id": 16794, "jp_tail": "の向こう側』へ」", "zh": "【ユウイチ】「回去吧。到另一侧去。到『围栏的另一侧』去」", "score": 88, "note": "", "adjudicate": false}
{"id": 16795, "jp_tail": "力が戻って来る。", "zh": "アヤノ的手上，重新有了力气。", "score": 68, "note": "", "adjudicate": false}
{"id": 16796, "jp_tail": "はゆっくりと――", "zh": "アヤノ慢慢地――", "score": 72, "note": "原文 16796 只有ゆっくりと，16798 才是とてもゆっくりと；恢复由慢到更慢的层递，16798 的「非常缓慢地」未动。", "adjudicate": false}
{"id": 16797, "jp_tail": "ノ】「――うん」", "zh": "【アヤノ】「――嗯」", "score": 88, "note": "", "adjudicate": false}
{"id": 16798, "jp_tail": "っくりと頷いた。", "zh": "非常缓慢地点了点头。", "score": 88, "note": "", "adjudicate": false}
{"id": 16799, "jp_tail": "へと引き上げた。", "zh": "我紧紧攥住アヤノ的手，使出浑身的力气，把アヤノ拉上了≪这一侧≫。", "score": 88, "note": "", "adjudicate": false}
{"id": 16800, "jp_tail": "く染まっていた。", "zh": "太阳已经落下，天台染上一片苍白。", "score": 68, "note": "原文染まる为自动词，去掉汉语侧自加的「被」（polish.md §2）。", "adjudicate": false}
{"id": 16801, "jp_tail": "を照らしている。", "zh": "月光照着两个人。", "score": 88, "note": "", "adjudicate": false}
{"id": 16802, "jp_tail": "生徒】「ね……」", "zh": "【女学生】「呐……」", "score": 88, "note": "", "adjudicate": false}
{"id": 16803, "jp_tail": "男子生徒】「ん」", "zh": "【男学生】「嗯」", "score": 88, "note": "", "adjudicate": false}
{"id": 16804, "jp_tail": "だったのかな？」", "zh": "【女学生】「谁都没见过的晚霞，那到底是什么呢？」", "score": 92, "note": "", "adjudicate": false}
{"id": 16805, "jp_tail": "子生徒】「んー」", "zh": "【男学生】「唔——」", "score": 88, "note": "", "adjudicate": false}
{"id": 16806, "jp_tail": "俺は考える。", "zh": "我思考着。", "score": 88, "note": "", "adjudicate": false}
{"id": 16807, "jp_tail": "の言葉の意味を。", "zh": "她那句话的意思。", "score": 88, "note": "", "adjudicate": false}
{"id": 16808, "jp_tail": "女子生徒】「ね」", "zh": "【女学生】「呐」", "score": 88, "note": "", "adjudicate": false}
{"id": 16809, "jp_tail": "男子生徒】「ん」", "zh": "【男学生】「嗯」", "score": 88, "note": "", "adjudicate": false}
{"id": 16810, "jp_tail": "に帰りたくない」", "zh": "【女学生】「有点……犯困了。可是呢，我还，不想回家」", "score": 88, "note": "", "adjudicate": false}
{"id": 16811, "jp_tail": "いてあげるから」", "zh": "【男学生】「稍微，休息一会儿就好。没关系，我会守着你的」", "score": 88, "note": "", "adjudicate": false}
{"id": 16812, "jp_tail": "子生徒】「うん」", "zh": "【女学生】「嗯」", "score": 88, "note": "", "adjudicate": false}
{"id": 16813, "jp_tail": "と目をつむった。", "zh": "她这么说着，闭上了眼睛。", "score": 88, "note": "", "adjudicate": false}
{"id": 16814, "jp_tail": "息をたて始める。", "zh": "过了一会儿，就开始发出睡得香甜的呼吸声。", "score": 80, "note": "寝息→呼吸声：SEG-4 给下游裁定第 2 条点名 16814（すやすや取「睡得香甜」）。", "adjudicate": false}
{"id": 16815, "jp_tail": "のを待っていた。", "zh": "我一边望着她的睡脸，一边等着朝阳升起。", "score": 88, "note": "", "adjudicate": false}
{"id": 17038, "jp_tail": "が完結しました。", "zh": "故事模式：章节８已完结。", "score": 95, "note": "", "adjudicate": false}
