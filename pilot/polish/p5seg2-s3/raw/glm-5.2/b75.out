{"id": 11953, "jp_tail": "＊】「アヤノ！」", "zh": "【＊＊＊】「Ayano！」", "score": 90, "note": "标签原样；全知纪律不点名（语音虽为 YUI，原文未给）。", "adjudicate": false}
{"id": 11954, "jp_tail": "アヤノ】「！？」", "zh": "【Ayano】「！？」", "score": 90, "note": "", "adjudicate": false}
{"id": 11955, "jp_tail": "この声は――！？", "zh": "这个声音是――！？ ", "score": 85, "note": "", "adjudicate": false}
{"id": 12072, "jp_tail": "へえ、階段ねえ」", "zh": "【Yuichi】「哦——，楼梯啊」", "score": 85, "note": "", "adjudicate": false}
{"id": 12073, "jp_tail": "ヤノ】「……む」", "zh": "【Ayano】「……唔」", "score": 88, "note": "「……む」族同形（11769/11832/12132）。", "adjudicate": false}
{"id": 12074, "jp_tail": "ろす格好になる。", "zh": "我一口气冲上楼梯，站到了比Yuichi高５级台阶的位置。在这个位置上，就成了俯视Yuichi的姿势。", "score": 82, "note": "全角５照原文；「一口气冲上楼梯」族（8062/11762）。", "adjudicate": false}
{"id": 12075, "jp_tail": "方を見ていった。", "zh": "我回过头去，望着Yuichi那边说道。", "score": 82, "note": "", "adjudicate": false}
{"id": 12076, "jp_tail": "ウワサがあるの」", "zh": "【Ayano】「这里啊，有一个不可思议的传闻哦」", "score": 85, "note": "", "adjudicate": false}
{"id": 12077, "jp_tail": "チ】「ウワサ？」", "zh": "【Yuichi】「传闻？」", "score": 85, "note": "", "adjudicate": false}
{"id": 12078, "jp_tail": "聞いたんだって」", "zh": "【Ayano】「对。听说呢，就在几年前，有很多学生从这道楼梯那边听见了奇怪的叫喊声哦」", "score": 82, "note": "", "adjudicate": false}
{"id": 12080, "jp_tail": "あ……お前――」", "zh": "【Yuichi】「又来了啊……你这家伙――」", "score": 85, "note": "", "adjudicate": false}
{"id": 12081, "jp_tail": "ノ】「待った！」", "zh": "【Ayano】「打住！」", "score": 85, "note": "", "adjudicate": false}
{"id": 12082, "jp_tail": "を遮っていった。", "zh": "我打断Yuichi的话说道。", "score": 85, "note": "「打断……的话」族（1854/7603/8412/10088/11662）。", "adjudicate": false}
{"id": 12083, "jp_tail": "たいんでしょ？」", "zh": "【Ayano】「反正你又想说是什么传闻啦、错觉啦、骗人的啦，对吧？」", "score": 85, "note": "「错觉」对齐 6148/7893/8040 族。", "adjudicate": false}
{"id": 12084, "jp_tail": "チ】「……むぐ」", "zh": "【Yuichi】「……唔咕」", "score": 82, "note": "むぐ 与む是两个词，中文分形（唔咕/唔），batch 75 手记。", "adjudicate": false}
{"id": 12085, "jp_tail": "いるんだって！」", "zh": "【Ayano】「可是不是那样的！ 听说真的有学生听见过这个声音哦！」", "score": 85, "note": "", "adjudicate": false}
{"id": 12086, "jp_tail": "チ】「本当に？」", "zh": "【Yuichi】「真的？」", "score": 85, "note": "", "adjudicate": false}
{"id": 12090, "jp_tail": "その時――", "zh": "就在那时――", "score": 85, "note": "对齐 8471 定形「就在那时――」，W3 误报已知（batch 75 手记），不压。", "adjudicate": false}
{"id": 12091, "jp_tail": "ウイチ】「あ！」", "zh": "【Yuichi】「啊！」", "score": 85, "note": "", "adjudicate": false}
{"id": 12092, "jp_tail": "叫び声を上げた。", "zh": "突然，Yuichi发出了很大的一声叫喊。", "score": 85, "note": "", "adjudicate": false}
{"id": 12093, "jp_tail": " どうしたの？」", "zh": "【Ayano】「什、什么！？ 怎么了？」", "score": 85, "note": "", "adjudicate": false}
{"id": 12094, "jp_tail": "ヤノ！ お……」", "zh": "【Yuichi】「Ayano！ 你……」", "score": 82, "note": "お＝お前半截，中文「你……」靠下行重复承担（batch 75 手记）。", "adjudicate": false}
{"id": 12095, "jp_tail": "な、なに……？」", "zh": "【Ayano】「诶？ 什、什么……？」", "score": 85, "note": "", "adjudicate": false}
{"id": 12096, "jp_tail": "前……後ろ……」", "zh": "【Yuichi】「你……后面……」", "score": 85, "note": "", "adjudicate": false}
{"id": 12097, "jp_tail": "がぞくりとした。", "zh": "难道说……。背脊一阵发凉。", "score": 85, "note": "「背脊一阵发凉」对齐 9843。", "adjudicate": false}
{"id": 12098, "jp_tail": "ノ……見ろ……」", "zh": "【Yuichi】「Ayano……你看……」", "score": 85, "note": "命令形但压着嗓子装神弄鬼，用「你看」不用「快看」（batch 75 手记）。", "adjudicate": false}
{"id": 12099, "jp_tail": "ろを振り返った。", "zh": "我慢慢地回过头去。", "score": 85, "note": "", "adjudicate": false}
{"id": 12100, "jp_tail": "私は後ろを向く。", "zh": "就像一台快要坏掉的机器人，我一边生硬地挪动着身体，一边转向后面。", "score": 82, "note": "", "adjudicate": false}
{"id": 12101, "jp_tail": "】「なんで……」", "zh": "【Yuichi】「为什么……」", "score": 85, "note": "「为什么……」悬置保留，不换「怎么会」（§全知纪律，batch 75 手记）。", "adjudicate": false}
{"id": 12102, "jp_tail": "イチはつぶやく。", "zh": "Yuichi嘀咕着。", "score": 85, "note": "「嘀咕」＝呟く主导形（SEG-6 裁定）。", "adjudicate": false}
{"id": 12103, "jp_tail": "何か……いる？」", "zh": "【Ayano】「我、我的后面……有什么……在吗？」", "score": 85, "note": "", "adjudicate": false}
{"id": 12104, "jp_tail": "】「そこに……」", "zh": "【Yuichi】「就在那里……」", "score": 85, "note": "", "adjudicate": false}
{"id": 12105, "jp_tail": "向こうを指した。", "zh": "Yuichi慢慢地抬起右手，用食指指向了我肩膀后方。", "score": 90, "note": "软锁：锚点行，照抄 opus。", "adjudicate": false}
{"id": 12106, "jp_tail": "な……なに……」", "zh": "【Ayano】「什……什么……」", "score": 85, "note": "", "adjudicate": false}
{"id": 12107, "jp_tail": "を凝らしてみる。", "zh": "我试着凝神细看。", "score": 85, "note": "「凝神细看」族（7892/9184/11405）。", "adjudicate": false}
{"id": 12108, "jp_tail": "は何も映らない。", "zh": "可是，我的眼里什么也没有映出来。", "score": 82, "note": "「映」字面保留（与下行「什么……也没有」两层没有构成演出，batch 75 手记）。", "adjudicate": false}
{"id": 12109, "jp_tail": "に、ユウイチ！」", "zh": "【Ayano】「怎、怎么样？ 是什么啊，Yuichi！」", "score": 82, "note": "", "adjudicate": false}
{"id": 12110, "jp_tail": "なにも……ない」", "zh": "【Yuichi】「什么……也没有」", "score": 85, "note": "", "adjudicate": false}
{"id": 12111, "jp_tail": "アヤノ】「……」", "zh": "【Ayano】「……」", "score": 90, "note": "", "adjudicate": false}
{"id": 12112, "jp_tail": "ことだ、アヤノ」", "zh": "【Yuichi】「总之呢，就是别被奇怪的传闻牵着鼻子走，Ayano」", "score": 85, "note": "", "adjudicate": false}
{"id": 12113, "jp_tail": "……こ……この」", "zh": "【Ayano】「……你……你这」", "score": 85, "note": "骂人话咽回去的半截，保留。", "adjudicate": false}
{"id": 12114, "jp_tail": "あるまいし……」", "zh": "【Yuichi】「什么？ 楼梯的传闻？ 又不是小学生……」", "score": 85, "note": "", "adjudicate": false}
{"id": 12115, "jp_tail": "…あんたねえ！」", "zh": "【Ayano】「你……你这家伙……我说你啊！」", "score": 85, "note": "口吃落「你」、复读第二次落「我说你啊」——首译已裁定的取舍，维持。", "adjudicate": false}
{"id": 12116, "jp_tail": "よな、そんなの」", "zh": "【Yuichi】「嘛，那种东西，怎么可能会有嘛」", "score": 85, "note": "", "adjudicate": false}
{"id": 12117, "jp_tail": "】「殴るわよ！」", "zh": "【Ayano】「我要揍你了！」", "score": 85, "note": "对齐 8608/8619「我要揍你了」，随原文补「了」。", "adjudicate": false}
{"id": 12118, "jp_tail": "体を横にずらす。", "zh": "Yuichi轻巧地把身体往旁边一闪。", "score": 85, "note": "「轻巧地……一闪」全库唯一搭配，首译定形。", "adjudicate": false}
{"id": 12119, "jp_tail": "避け……って！」", "zh": "【Ayano】「哇！ 干嘛躲……哎呀！」", "score": 85, "note": "", "adjudicate": false}
{"id": 12120, "jp_tail": "れるかってーの」", "zh": "【Yuichi】「谁能一次又一次挨你揍啊」", "score": 85, "note": "「挨你揍」与 12117「我要揍你了」勾连（首译留痕）。", "adjudicate": false}
{"id": 12121, "jp_tail": "崩してしまった。", "zh": "朝着空处挥下手臂的我，身体一下子大大地失去了平衡。", "score": 85, "note": "「失去了平衡」族（3644/3736/3852）待 s7f 复用，勿改「站不稳」；「大大地失去平衡」与「大大地叹气」不同搭配（動詞は「崩す」），保留。", "adjudicate": false}
{"id": 12122, "jp_tail": "だ、だめっ……」", "zh": "【Ayano】「不、不行……」", "score": 85, "note": "", "adjudicate": false}
{"id": 12123, "jp_tail": "段が迫ってくる。", "zh": "楼梯朝着我的眼前逼近过来。", "score": 85, "note": "", "adjudicate": false}
{"id": 12124, "jp_tail": "このままでは――", "zh": "不行，再这样下去――", "score": 85, "note": "", "adjudicate": false}
{"id": 12125, "jp_tail": "「……ユウイチ」", "zh": "【Ayano】「……Yuichi」", "score": 85, "note": "", "adjudicate": false}
{"id": 12126, "jp_tail": "に手がでるのな」", "zh": "【Yuichi】「……真是的。你这家伙，嘴还没动，手就先上了啊」", "score": 90, "note": "软锁：锚点行，照抄 opus。", "adjudicate": false}
{"id": 12127, "jp_tail": "、……ありがと」", "zh": "【Ayano】「那、那个……呃……啊，……谢谢」", "score": 85, "note": "", "adjudicate": false}
{"id": 12128, "jp_tail": "をそっと掴んだ。", "zh": "我轻轻地抓住了Yuichi的胸口。", "score": 85, "note": "v9 裁定：肩→胸统一（与 12133「揪着我的胸口」连贯），具名例外不外推。", "adjudicate": false}
{"id": 12129, "jp_tail": "かくて大きな肩。", "zh": "温暖而宽厚的胸膛。", "score": 85, "note": "v9 裁定成对行，照抄。", "adjudicate": false}
{"id": 12130, "jp_tail": "んだからねっ！」", "zh": "【Ayano】「可……可是！ 归根到底，是Yuichi你闹着玩才不对的嘛！」", "score": 85, "note": "", "adjudicate": false}
{"id": 12131, "jp_tail": "せんでしたって」", "zh": "【Yuichi】「……好啦好啦，都说了对不起了嘛」", "score": 85, "note": "", "adjudicate": false}
{"id": 12132, "jp_tail": "ヤノ】「……む」", "zh": "【Ayano】「……唔」", "score": 88, "note": "与 11769/11832/12073 同形。", "adjudicate": false}
{"id": 12133, "jp_tail": "まってるわけ？」", "zh": "【Yuichi】「……那么。你打算揪着我的胸口不放到什么时候啊？」", "score": 85, "note": "", "adjudicate": false}
{"id": 12134, "jp_tail": "ヤノ】「あっ！」", "zh": "【Ayano】「啊！」", "score": 85, "note": "", "adjudicate": false}
