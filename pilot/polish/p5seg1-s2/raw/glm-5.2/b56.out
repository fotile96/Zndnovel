{"id": 9805, "jp_tail": "対に効くぞっ！」", "zh": "【Ayano】「好……这个咒语……绝对灵验！」", "score": 90, "note": "", "adjudicate": false}
{"id": 9806, "jp_tail": "……。", "zh": "……", "score": 95, "note": "", "adjudicate": false}
{"id": 9807, "jp_tail": "いいものの……。", "zh": "……话是这么喊出口了，可是……", "score": 95, "note": "", "adjudicate": false}
{"id": 9808, "jp_tail": "恥ずかしい……。", "zh": "……果、果然……还是有点难为情……", "score": 95, "note": "", "adjudicate": false}
{"id": 9809, "jp_tail": "にとりかかった。", "zh": "我开始做起了咒语。", "score": 95, "note": "9809≡9812≡9815 三支共用收尾句，逐字沿用族形", "adjudicate": false}
{"id": 10032, "jp_tail": "「……ひゃん！」", "zh": "【Ayano】「……呀啊！」", "score": 90, "note": "", "adjudicate": false}
