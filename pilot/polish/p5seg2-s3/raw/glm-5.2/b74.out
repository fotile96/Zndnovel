{"id": 11759, "jp_tail": "】「ユウイチ！」", "zh": "【Ayano】「Yuichi！」", "score": 90, "note": "", "adjudicate": false}
{"id": 11760, "jp_tail": "の名前を呼んだ。", "zh": "Ayano大声喊了Yuichi的名字。", "score": 85, "note": "", "adjudicate": false}
{"id": 11761, "jp_tail": "ていこうとする。", "zh": "可是Yuichi明明应该听得见，却完全无视Ayano的话，径直要往楼梯上走。", "score": 80, "note": "", "adjudicate": false}
{"id": 11762, "jp_tail": "を駆け上がった。", "zh": "Ayano拼命跑过走廊，一口气冲上了楼梯。", "score": 85, "note": "「一口气冲上楼梯」族（8062/11762/11865），保「了」。", "adjudicate": false}
{"id": 11763, "jp_tail": "ウイチってば！」", "zh": "【Ayano】「Yuichi！ 说你呢！」", "score": 85, "note": "沿用 9233「アヤノってば！」句式（仅换人名）。", "adjudicate": false}
{"id": 11764, "jp_tail": "ウイチ】「……」", "zh": "【Yuichi】「……」", "score": 90, "note": "", "adjudicate": false}
{"id": 11765, "jp_tail": "ユウイチさん？」", "zh": "【Ayano】「Yuichi先生？」", "score": 90, "note": "v7 具名例外：揶揄敬称位→Yuichi先生，对齐 7913/9304/9308。", "adjudicate": false}
{"id": 11766, "jp_tail": "ウイチ】「……」", "zh": "【Yuichi】「……」", "score": 90, "note": "", "adjudicate": false}
{"id": 11767, "jp_tail": "……イチさま？」", "zh": "【Ayano】「……Yu……ichi大人？」", "score": 82, "note": "敬称升级阶梯（！→ってば→さん→さま），断点「Yu……ichi」原样保留。", "adjudicate": false}
{"id": 11768, "jp_tail": "ウイチ】「……」", "zh": "【Yuichi】「……」", "score": 90, "note": "", "adjudicate": false}
{"id": 11769, "jp_tail": "ヤノ】「……む」", "zh": "【Ayano】「……唔」", "score": 88, "note": "「……む」→「……唔」族（7380/7618/8577），全批同形。", "adjudicate": false}
{"id": 11770, "jp_tail": "イチ】「ぐほぉ」", "zh": "【Yuichi】「咕哦」", "score": 80, "note": "全库唯一拟声，首译「咕哦」保留。", "adjudicate": false}
{"id": 11771, "jp_tail": "にうずくまった。", "zh": "Yuichi发出一声奇怪的叫喊，当场蹲了下去。", "score": 85, "note": "", "adjudicate": false}
{"id": 11772, "jp_tail": "はないでしょ！」", "zh": "【Ayano】「我说你啊，人家在叫你名字，你倒是没必要装听不见吧！」", "score": 72, "note": "§14/口调：「也用不着完全无视吧」把無視する直搬成「无视」，汉语口语此处更自然的说法是「装听不见」；「人家在叫你名字」承「人家」的对撒娇腔。改动保住 aんたねえ→「我说你啊」族头。", "adjudicate": false}
{"id": 11773, "jp_tail": "んなところで？」", "zh": "【Yuichi】「……疼死了……哎，Ayano？ 你在这种地方干嘛呢？」", "score": 85, "note": "", "adjudicate": false}
{"id": 11774, "jp_tail": "の方なんだから」", "zh": "【Ayano】「我说啊。想问这话的，明明是我这边才对吧」", "score": 76, "note": "§14：「该问这话的，明明是我」首读可挂到「问话」上读岔；「想问这话的」把 こっちの方（问的一方）落稳。", "adjudicate": false}
{"id": 11775, "jp_tail": "ぶつけてる……」", "zh": "【Ayano】「还是老样子晃晃悠悠地走着呢……，啊，头撞到柱子上了……」", "score": 85, "note": "", "adjudicate": false}
{"id": 11776, "jp_tail": "ておけばいいや。", "zh": "总之……那家伙，就先不管他了吧。", "score": 90, "note": "软锁：锚点行，照抄 opus。", "adjudicate": false}
{"id": 11777, "jp_tail": "ても大丈夫かな？", "zh": "差不多，可以去小菊那边了吧？", "score": 85, "note": "「去小菊那边看看」族词干保留。", "adjudicate": false}
{"id": 11778, "jp_tail": "、またぶつけた」", "zh": "【Ayano】「……啊，又撞上了」", "score": 85, "note": "", "adjudicate": false}
{"id": 11779, "jp_tail": "落ついたようだ。", "zh": "看来社团活动也告一段落了。", "score": 85, "note": "「告一段落」对齐 9774。", "adjudicate": false}
{"id": 11780, "jp_tail": "ノ。どしたの？」", "zh": "【小菊】「啊，Ayano。怎么啦？」", "score": 85, "note": "", "adjudicate": false}
{"id": 11781, "jp_tail": "ちゃんが答えた。", "zh": "小菊一发现Ayano，就应了这么一句。", "score": 70, "note": "§14：「看到Ayano的脸，这么应道」直搬顔を見つめて（视线动作被译成看脸），且「这么应道」悬空生硬；「一发现……就应了这么一句」是自然的汉语转写。", "adjudicate": false}
{"id": 11782, "jp_tail": "今忙しくない？」", "zh": "【Ayano】「社团活动，没关系吗？ 现在不忙吗？」", "score": 85, "note": "", "adjudicate": false}
{"id": 11783, "jp_tail": "だから。あ……」", "zh": "【小菊】「没问题！ 我正好在想着要不要休息一下呢。啊……」", "score": 85, "note": "", "adjudicate": false}
{"id": 11784, "jp_tail": "ちゃんは答えた。", "zh": "小菊一边伸展着身体，一边答道。", "score": 85, "note": "", "adjudicate": false}
{"id": 11785, "jp_tail": "アヤノ】「ん？」", "zh": "【Ayano】「嗯？」", "score": 90, "note": "", "adjudicate": false}
{"id": 11786, "jp_tail": "なかったっけ？」", "zh": "【小菊】「说到社团，Ayano你已经不做了吗？ 我记得，你不是本来打算去羽毛球部的吗？」", "score": 85, "note": "", "adjudicate": false}
{"id": 11787, "jp_tail": "、辞めちゃった」", "zh": "【Ayano】「嗯。刚入学那阵子是在羽毛球部来着。……不过顾问老师有点太『严厉』了，就退部了」", "score": 85, "note": "『厳しく』引号跨度原样；顾问老师→v9 例外表。", "adjudicate": false}
{"id": 11789, "jp_tail": "ゃなくて江口ね」", "zh": "【小菊】「羽毛球部……啊——，就是那个色鬼……不对，是江口吧」", "score": 85, "note": "ruby 已去（江口不需注音）；「色鬼」承接『エロ』绰号构词。", "adjudicate": false}
{"id": 11790, "jp_tail": "っと、ヤだった」", "zh": "【Ayano】「会让人在雨里跑步什么的呢。总觉得有点、讨厌」", "score": 85, "note": "", "adjudicate": false}
{"id": 11791, "jp_tail": "あたしも嫌かも」", "zh": "【小菊】「唔——。的确……。那样的话，我大概也会讨厌吧」", "score": 85, "note": "", "adjudicate": false}
{"id": 11792, "jp_tail": "らいだったから」", "zh": "【Ayano】「真正认真的人还是坚持下来了啦。我本来也就是『能稍微活动活动身体就行』的程度嘛」", "score": 85, "note": "", "adjudicate": false}
{"id": 11793, "jp_tail": "入ればいいのに」", "zh": "【小菊】「Ayano也进田径部就好了呀」", "score": 85, "note": "", "adjudicate": false}
{"id": 11794, "jp_tail": "走るの苦手だし」", "zh": "【Ayano】「我不行不行的。再说我也不擅长跑步」", "score": 90, "note": "软锁：锚点行，照抄 opus。", "adjudicate": false}
{"id": 11795, "jp_tail": "いってないよね」", "zh": "【小菊】「是吗？ 大家一开始都这么说，没关系的哦。说起来，Yuichi君也没参加社团吧」", "score": 85, "note": "", "adjudicate": false}
{"id": 11796, "jp_tail": "てないんだって」", "zh": "【Ayano】「嗯。Yuichi完全不行。他说他根本就不适合集体行动」", "score": 85, "note": "", "adjudicate": false}
{"id": 11797, "jp_tail": "、部活も――？」", "zh": "【小菊】「呵呵，果然是因为想和Yuichi君一起放学回家，所以社团也――？」", "score": 85, "note": "", "adjudicate": false}
{"id": 11798, "jp_tail": "、それでね――」", "zh": "【Ayano】「才、才不是啦，说了不是那样的！ 啊，那个，所以说呢――」", "score": 85, "note": "", "adjudicate": false}
{"id": 11799, "jp_tail": "でしまいそうだ。", "zh": "照这样下去，话题又要往Yuichi身上转了。", "score": 85, "note": "", "adjudicate": false}
{"id": 11800, "jp_tail": "ついて説明した。", "zh": "Ayano向小菊说明了到目前为止打听来的楼梯的传闻。", "score": 85, "note": "", "adjudicate": false}
{"id": 11801, "jp_tail": "ちゃん】「あー」", "zh": "【小菊】「啊——」", "score": 85, "note": "", "adjudicate": false}
{"id": 11802, "jp_tail": "ポリポリと掻く。", "zh": "小菊一边这么说着，一边挠了挠头。", "score": 85, "note": "", "adjudicate": false}
{"id": 11803, "jp_tail": "……知ってる？」", "zh": "【Ayano】「……你知道吗？」", "score": 85, "note": "", "adjudicate": false}
{"id": 11804, "jp_tail": "。センパイから」", "zh": "【小菊】「嗯。算是……听说过哦。从前辈那里」", "score": 85, "note": "「前辈」对齐 7431（センパイ 片假名同译）。", "adjudicate": false}
{"id": 11805, "jp_tail": "ていたみたいだ。", "zh": "看来，老师猜中了。", "score": 90, "note": "软锁：锚点行，照抄 opus。", "adjudicate": false}
{"id": 11806, "jp_tail": "験したらしいよ」", "zh": "【小菊】「我记得是。我们部里的前辈们，以前集训住校的时候好像经历过那样的事哦」", "score": 85, "note": "", "adjudicate": false}
{"id": 11807, "jp_tail": "てきたらしくて」", "zh": "【小菊】「一开始被当成是错觉了，可后来就变成我也听见了、我也听见了。听说还有人身体不舒服」", "score": 85, "note": "「我也听见了、我也听见了」复读保留（原文 私も聞いた×2 是演出）。", "adjudicate": false}
{"id": 11808, "jp_tail": "やってるけどさ」", "zh": "【小菊】「结果那之后，有一阵子集训好像不在学校，改到别的地方办了。现在又在学校办了就是了」", "score": 85, "note": "", "adjudicate": false}
{"id": 11809, "jp_tail": "―あるかな……」", "zh": "【小菊】「不过呢。果然，关于这件事，就算在部里也有种不太好开口的气氛――大概是有的吧……」", "score": 80, "note": "破折号＋「大概是有的吧……」保留原文悬置（話しにくい雰囲気…あるかな 的迟疑），§12。", "adjudicate": false}
{"id": 11810, "jp_tail": "かったのかな？」", "zh": "【Ayano】「可是，为什么保健室老师，不肯告诉我呢？」", "score": 82, "note": "", "adjudicate": false}
{"id": 11811, "jp_tail": "リとつぶやいた。", "zh": "Ayano小声地嘟囔了一句。", "score": 85, "note": "「嘟囔」属呟く少数形但此行已入线且为全库唯一 アヤノ位单句，维持不动。", "adjudicate": false}
{"id": 11812, "jp_tail": "にも聞いたんだ」", "zh": "【小菊】「嗯？ Ayano你连保健老师也问过了呀」", "score": 85, "note": "", "adjudicate": false}
{"id": 11813, "jp_tail": "きながら答えた。", "zh": "Ayano一边点头一边答道。", "score": 85, "note": "", "adjudicate": false}
{"id": 11814, "jp_tail": "ぐらいかなって」", "zh": "【Ayano】「因为我想着，要说在这所学校待得久的老师，也就保健老师和校长、教导主任这些了吧」", "score": 85, "note": "校長→校长、教頭先生→教导主任（v9 职名例外表）。", "adjudicate": false}
{"id": 11815, "jp_tail": "めなさい』って」", "zh": "【Ayano】「然后呢，一上来就去找校长什么的又太那个了，所以问了保健老师，结果被说『那种事就别问了』」", "score": 82, "note": "内层『』是压缩转述，与 11656 原话不等长属人物口吻，保留。", "adjudicate": false}
{"id": 11816, "jp_tail": "仕方ないかもね」", "zh": "【小菊】「唔——。这样啊……嘛，那也是没办法的吧」", "score": 85, "note": "", "adjudicate": false}
{"id": 11817, "jp_tail": "せながら答えた。", "zh": "小菊微微蹙起眉头，答道。", "score": 85, "note": "", "adjudicate": false}
{"id": 11818, "jp_tail": "え、どうして？」", "zh": "【Ayano】「咦，为什么？」", "score": 85, "note": "", "adjudicate": false}
{"id": 11819, "jp_tail": "ってことでしょ」", "zh": "【小菊】「因为，听了那个什么『声音』之类的东西，出现了一大批身体不舒服的学生，对吧」", "score": 85, "note": "", "adjudicate": false}
{"id": 11820, "jp_tail": "が高いのは――」", "zh": "【小菊】「那样的话，首先，最有可能去的地方是――」", "score": 82, "note": "", "adjudicate": false}
{"id": 11821, "jp_tail": "そっか。保健室」", "zh": "【Ayano】「啊……。这样啊。保健室」", "score": 85, "note": "", "adjudicate": false}
{"id": 11822, "jp_tail": "きたんでしょう」", "zh": "【小菊】「嗯。更何况，那之后还有人不愿再被提起这件事，对吧」", "score": 85, "note": "", "adjudicate": false}
{"id": 11823, "jp_tail": "といけないよね」", "zh": "【小菊】「这么一来，老师就必须保护那个学生了呢」", "score": 85, "note": "", "adjudicate": false}
{"id": 11824, "jp_tail": "】「……そっか」", "zh": "【Ayano】「……这样啊」", "score": 85, "note": "", "adjudicate": false}
{"id": 11825, "jp_tail": "っていう所かな」", "zh": "【小菊】「嘛，Ayano的心情能理解，老师的心情也能理解……大概就是这么回事吧」", "score": 82, "note": "", "adjudicate": false}
{"id": 11827, "jp_tail": "】「うーん……」", "zh": "【Ayano】「唔——……」", "score": 85, "note": "", "adjudicate": false}
{"id": 11828, "jp_tail": "ぶ声が聞こえた。", "zh": "就在这时，传来了呼唤小菊的声音。", "score": 85, "note": "", "adjudicate": false}
{"id": 11829, "jp_tail": "な感じでいい？」", "zh": "【小菊】「啊！ 对不起，我得去帮忙收拾了。Ayano，这样就行了吗？」", "score": 82, "note": "", "adjudicate": false}
{"id": 11830, "jp_tail": "ん。ありがと！」", "zh": "【Ayano】「嗯。谢谢！」", "score": 90, "note": "软锁：锚点行，照抄 opus。", "adjudicate": false}
{"id": 11831, "jp_tail": "屋でいいから！」", "zh": "【小菊】「车站前的甜甜圈店就行啦！」", "score": 85, "note": "甜甜圈=银珠糖暗号族词面（千秋口调表 §6），锁死。", "adjudicate": false}
{"id": 11832, "jp_tail": "ヤノ】「……む」", "zh": "【Ayano】「……唔」", "score": 88, "note": "与 11769/12132 同形同译。", "adjudicate": false}
{"id": 11833, "jp_tail": "向に走っていく。", "zh": "小菊留下这句话，便朝着声音的方向跑去了。", "score": 85, "note": "", "adjudicate": false}
{"id": 11834, "jp_tail": "ノ】「……ふう」", "zh": "【Ayano】「……呼」", "score": 85, "note": "", "adjudicate": false}
{"id": 11835, "jp_tail": "ため息をついた。", "zh": "Ayano望着小菊的身影，小小地叹了口气。", "score": 85, "note": "「小小地叹了口气」＝サクラ位（11338）；Ayano 位同场全库另有「叹了一小口气」系（7/13/105），但此行已入线且同章沿用，维持不动避免族内漂移。", "adjudicate": false}
{"id": 11836, "jp_tail": "かであるらしい。", "zh": "楼梯的传闻，是吗。『那件事』确实发生过，这一点看来是确凿的。", "score": 82, "note": "", "adjudicate": false}
{"id": 11837, "jp_tail": "わからなかった。", "zh": "可是，虽然一路打听了各种各样的说法，结果详细的情形还是没能弄明白。", "score": 90, "note": "软锁：锚点行，照抄 opus。", "adjudicate": false}
{"id": 11838, "jp_tail": "ような気がする。", "zh": "总觉得，再想打听到更详细的事，会很难。", "score": 80, "note": "", "adjudicate": false}
{"id": 11839, "jp_tail": "しようかな……。", "zh": "接下来，该怎么办呢……", "score": 90, "note": "软锁：锚点行，照抄 opus。", "adjudicate": false}
{"id": 11840, "jp_tail": "言ってたし……。", "zh": "Sakura同学，刚才不在图书室，不过……她说过放学后经常去那里的……", "score": 90, "note": "软锁：锚点行，照抄 opus。", "adjudicate": false}
{"id": 11841, "jp_tail": "いだけの話だし！", "zh": "嘛，虽然可能见不到，不过大不了回教室就是了！", "score": 85, "note": "", "adjudicate": false}
{"id": 11842, "jp_tail": "えてみようかな。", "zh": "总之，就把到目前为止调查出来的事情告诉她看看吧。", "score": 85, "note": "", "adjudicate": false}
{"id": 11843, "jp_tail": "描き出していた。", "zh": "从窗户照进来的夕阳，在走廊上描出了橙与黑的强烈对比。", "score": 82, "note": "「对比」对齐 7995（コントラスト）。", "adjudicate": false}
{"id": 11844, "jp_tail": "別な感じがした。", "zh": "明明是平时每天走过、看惯了的走廊，可像这样被夕阳照着，就有了一种特别的感觉。", "score": 82, "note": "", "adjudicate": false}
{"id": 11845, "jp_tail": "も見えなかった。", "zh": "校舍里应该还留着学生才对，可走廊上除了Ayano以外，谁的身影也看不见。", "score": 80, "note": "", "adjudicate": false}
{"id": 11846, "jp_tail": "音が耳に入った。", "zh": "就在那时。不知从哪里，橡胶摩擦的声音钻进了耳朵。", "score": 85, "note": "对齐 9901 同族（少 僅かに 形）；「橡胶摩擦的声音」不消歧（§全知纪律）。", "adjudicate": false}
{"id": 11847, "jp_tail": "まだ居るのかな？", "zh": "那个，是有谁……还留在这里吗？", "score": 82, "note": "", "adjudicate": false}
{"id": 11848, "jp_tail": "もいるみたいだ。", "zh": "看来校舍里也还有没回去的学生。", "score": 82, "note": "", "adjudicate": false}
{"id": 11849, "jp_tail": "ヤノ】「あれ？」", "zh": "【Ayano】「咦？」", "score": 85, "note": "", "adjudicate": false}
{"id": 11850, "jp_tail": "た、ユウイチ？」", "zh": "【Ayano】「又是，Yuichi？」", "score": 82, "note": "", "adjudicate": false}
{"id": 11851, "jp_tail": "が、また見えた。", "zh": "Yuichi的身影，又一次出现了。", "score": 85, "note": "强调また的读点原样保留（batch 74 手记）。", "adjudicate": false}
{"id": 11852, "jp_tail": "見てみようかな」", "zh": "【Ayano】「楼梯，是吗。虽然不太提得起劲……不过就稍微，去看一眼吧」", "score": 85, "note": "", "adjudicate": false}
